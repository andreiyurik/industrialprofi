<%# Compact results for the header palette (see shared/_palette). A blank
    query re-renders the quick destinations, so clearing the input restores
    the palette's home state. %>
<%= turbo_frame_tag "palette_results", target: "_top" do %>
  <% if @query.blank? %>
    <%= render "shared/palette_home" %>
  <% elsif @results.empty? %>
    <p class="palette__empty">
      <%= t("search.empty", query: @query) %>
      <%= link_to t("search.browse_catalog"), paths_path %>.
    </p>
  <% else %>
    <ul class="palette-results">
      <% @results.first(8).each do |result| %>
        <li>
          <%= link_to lesson_path(result.lesson), class: "palette-result" do %>
            <span class="palette-result__title"><%= result.lesson.title %></span>
            <span class="palette-result__crumbs"><%= result.lesson.path.title %> · <%= result.lesson.course.title %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= link_to t("palette.all_results", count: @results.size), search_path(q: @query), class: "palette__all" %>
  <% end %>
<% end %>
