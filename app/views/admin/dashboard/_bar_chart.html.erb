<%# week_title_key is unused by the JS chart; kept so callers stay unchanged. -%>
<div class="admin-group">
  <div class="admin-group__head">
    <h2 class="admin-group__title"><%= title %></h2>
    <span class="admin-group__meta"><%= t("admin.dashboard.chart_period", weeks: data.size) %></span>
  </div>
  <div class="admin-chart-canvas">
    <canvas data-controller="admin-chart"
            data-admin-chart-labels-value="<%= data.map { |week_start, _| l(week_start, format: :short) }.to_json %>"
            data-admin-chart-counts-value="<%= data.map(&:last).to_json %>"
            data-admin-chart-label-value="<%= title %>"></canvas>
  </div>
</div>
