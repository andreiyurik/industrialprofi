<%# slug_locked? gates on persisted? && status_live? — a new record is always editable. %>
<div class="admin-form__field">
  <label><%= t("admin.field_slug") %></label>
  <% if slug_locked?(record) %>
    <%= f.text_field :slug, class: "input input--mono", disabled: true %>
    <p class="admin-form__hint"><%= t("admin.slug_locked") %></p>
  <% else %>
    <%= f.text_field :slug, class: "input input--mono", placeholder: t("admin.slug_auto") %>
    <p class="admin-form__hint"><%= t("admin.slug_hint") %></p>
  <% end %>
</div>
