<%# Shared by new + edit. form_with routes to create/update by record state.
    file_field flips the form to multipart automatically. %>
<%= form_with(model: [ :admin, post ], class: "admin-form") do |f| %>
  <%= render "admin/shared/form_errors", object: post %>

  <div class="admin-form__field">
    <label><%= t("admin.field_title") %></label>
    <%= f.text_field :title, class: "input" %>
  </div>

  <div class="admin-form__field">
    <label><%= t("admin.field_slug") %></label>
    <% if slug_locked?(post) %>
      <%= f.text_field :slug, class: "input input--mono", disabled: true %>
      <p class="admin-form__hint"><%= t("admin.slug_locked") %></p>
    <% else %>
      <%= f.text_field :slug, class: "input input--mono", placeholder: t("admin.slug_auto") %>
      <p class="admin-form__hint"><%= t("admin.slug_hint") %></p>
    <% end %>
  </div>

  <div class="admin-form__field">
    <label><%= t("admin.field_excerpt") %></label>
    <%= f.text_area :excerpt, rows: 3, class: "input input--textarea" %>
    <p class="admin-form__hint"><%= t("admin.excerpt_hint") %></p>
  </div>

  <div class="admin-form__field">
    <label><%= t("admin.field_hero_image") %></label>
    <% if post.hero_image.attached? %>
      <%= image_tag post.hero_image, class: "admin-form__preview", alt: "" %>
    <% end %>
    <%= f.file_field :hero_image, accept: LessonImageUpload.accept_attribute %>
    <p class="admin-form__hint"><%= t("admin.hero_image_hint") %></p>
  </div>

  <%# Images enabled on the body, routed through the same validating, gated
      upload endpoint the lesson editor uses (image-only, size-capped). %>
  <% max_upload = LessonImageUpload::MAX_BYTES
     image_opts = {
       "permitted-attachment-types" => LessonImageUpload.accept_attribute,
       data: {
         direct_upload_url: admin_uploads_path,
         controller: "lexxy-uploads",
         "lexxy-uploads-max-bytes-value": max_upload,
         "lexxy-uploads-message-value": t("admin.uploads.too_large", max: number_to_human_size(max_upload))
       }
     } %>
  <div class="admin-form__field admin-form__field--lg">
    <label><%= t("admin.field_body") %></label>
    <%= f.rich_text_area :rich_body, class: "lexxy-content", **image_opts %>
    <p class="admin-form__hint"><%= t("admin.uploads.hint") %></p>
  </div>

  <%= render "admin/shared/status_field", f: f, record: post %>

  <div class="admin-form__actions">
    <%= f.submit t("admin.save"), class: "btn btn--reversed" %>
    <a href="<%= admin_posts_path %>" class="btn"><%= t("admin.cancel") %></a>
  </div>
<% end %>
