<% meta_title("#{t('admin.edit_post')} — #{@post.title}") %>

<section class="admin-page">
  <div class="container">
    <%= render "admin/shared/nav" %>

    <div class="admin-header">
      <div class="admin-header__title-group">
        <a href="<%= admin_posts_path %>" class="admin-header__back" aria-label="<%= t('admin.back') %>">
          <%= icon_tag("arrow-left") %>
        </a>
        <h1 class="admin-header__title"><%= @post.title %></h1>
      </div>
      <% if @post.published? %>
        <a href="<%= post_path(@post) %>" class="admin-header__view-live link-quiet" target="_blank"><%= t("admin.view_live") %> ↗</a>
      <% end %>
    </div>

    <%= render "admin/posts/form", post: @post %>

    <div class="admin-danger">
      <h2 class="admin-danger__title"><%= t("admin.builder.danger_zone") %></h2>
      <%= button_to t("admin.delete_post"), admin_post_path(@post), method: :delete,
            class: "btn btn--negative btn--small",
            data: { turbo_confirm: t("admin.delete_post_confirm", title: @post.title) } %>
    </div>
  </div>
</section>
