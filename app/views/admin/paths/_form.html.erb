<%# Shared by new + edit. form_with routes to create/update by record state. %>
<%= form_with(model: [ :admin, path ], class: "admin-form") do |f| %>
  <%= render "admin/shared/form_errors", object: path %>

  <div class="admin-form__field">
    <label><%= t("admin.field_title") %></label>
    <%= f.text_field :title, class: "input" %>
  </div>

  <%= render "admin/shared/slug_field", f: f, record: path %>

  <div class="admin-form__field">
    <label><%= t("admin.field_description") %></label>
    <%= f.text_area :description, rows: 4, class: "input input--textarea" %>
  </div>

  <%= render "admin/shared/icon_field", f: f, record: path %>

  <%= render "admin/shared/status_field", f: f, record: path %>

  <%# The «О профессии» landing: six slots, each a plain textarea (markdown or
      one item per line) — the placeholder is the manual. Same slots the pack's
      landing.yml carries; see Path::Landing. %>
  <fieldset class="admin-form__group" id="landing-editor">
    <legend class="admin-form__group-title"><%= t("admin.landing.heading") %></legend>
    <p class="admin-form__hint"><%= t("admin.landing.hint") %></p>

    <div class="admin-form__field">
      <label><%= t("admin.landing.cover") %></label>
      <%# Only a saved cover can be previewed — after a refused upload the form
          re-renders with an unsaved attachment that has no URL yet. %>
      <% if path.cover.attached? && path.cover.blob&.persisted? %>
        <%= image_tag path.cover, class: "admin-form__preview", alt: "" %>
        <label class="admin-form__check">
          <%= check_box_tag "path[remove_cover]", "1", false %>
          <span><%= t("admin.landing.remove_cover") %></span>
        </label>
      <% end %>
      <%= f.file_field :cover, accept: LessonImageUpload.accept_attribute %>
      <p class="admin-form__hint"><%= t("admin.landing.cover_hint") %></p>
      <%= f.text_field :cover_credit, class: "input", placeholder: t("admin.landing.cover_credit_placeholder"), maxlength: 200 %>
      <p class="admin-form__hint"><%= t("admin.landing.cover_credit_hint") %></p>
    </div>

    <div class="admin-form__field admin-form__field--lg">
      <label><%= t("admin.landing.about") %></label>
      <%= f.text_area :about, rows: 8, class: "input input--textarea", placeholder: t("admin.landing.about_placeholder") %>
      <p class="admin-form__hint"><%= t("admin.landing.markdown_hint") %></p>
    </div>

    <div class="admin-form__field">
      <label><%= t("admin.landing.highlights") %></label>
      <%= f.text_area :highlights_text, rows: 5, class: "input input--textarea", placeholder: t("admin.landing.highlights_placeholder") %>
      <p class="admin-form__hint"><%= t("admin.landing.list_hint") %></p>
    </div>

    <div class="admin-form__field">
      <label><%= t("admin.landing.pros") %></label>
      <%= f.text_area :pros_text, rows: 4, class: "input input--textarea", placeholder: t("admin.landing.pros_placeholder") %>
    </div>

    <div class="admin-form__field">
      <label><%= t("admin.landing.cons") %></label>
      <%= f.text_area :cons_text, rows: 4, class: "input input--textarea", placeholder: t("admin.landing.cons_placeholder") %>
      <p class="admin-form__hint"><%= t("admin.landing.pros_cons_hint") %></p>
    </div>

    <div class="admin-form__field admin-form__field--lg">
      <label><%= t("admin.landing.history") %></label>
      <%= f.text_area :history, rows: 6, class: "input input--textarea", placeholder: t("admin.landing.history_placeholder") %>
      <p class="admin-form__hint"><%= t("admin.landing.markdown_hint") %></p>
    </div>

    <div class="admin-form__field admin-form__field--lg">
      <label><%= t("admin.landing.faq") %></label>
      <%= f.text_area :faq, rows: 8, class: "input input--textarea", placeholder: t("admin.landing.faq_placeholder") %>
      <p class="admin-form__hint"><%= t("admin.landing.faq_hint") %></p>
    </div>
  </fieldset>

  <div class="admin-form__actions">
    <%= f.submit t("admin.save"), class: "btn btn--reversed" %>
    <a href="<%= path.persisted? ? admin_path_path(path) : admin_paths_path %>" class="btn"><%= t("admin.cancel") %></a>
  </div>
<% end %>
