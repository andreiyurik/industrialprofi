<%# Shared by new + edit. form_with routes to create/update by record state. %>
<%= form_with(model: [ :admin, path ], class: "admin-form") do |f| %>
  <%= render "admin/shared/form_errors", object: path %>

  <div class="admin-form__field">
    <label><%= t("admin.field_title") %></label>
    <%= f.text_field :title, class: "input" %>
  </div>

  <%= render "admin/shared/slug_field", f: f, record: path %>

  <div class="admin-form__field">
    <label><%= t("admin.field_description") %></label>
    <%= f.text_area :description, rows: 4, class: "input input--textarea" %>
  </div>

  <%= render "admin/shared/icon_field", f: f, record: path %>

  <%= render "admin/shared/status_field", f: f, record: path %>

  <div class="admin-form__actions">
    <%= f.submit t("admin.save"), class: "btn btn--reversed" %>
    <a href="<%= path.persisted? ? admin_path_path(path) : admin_paths_path %>" class="btn"><%= t("admin.cancel") %></a>
  </div>
<% end %>
