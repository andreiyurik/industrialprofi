<% meta_title("#{t('admin.builder.title')} · #{@path.title}") %>

<section class="admin-page">
  <div class="container">
    <%= render "admin/shared/nav" %>

    <div class="admin-header">
      <div class="admin-header__title-group">
        <a href="<%= admin_paths_path %>" class="admin-header__back" aria-label="<%= t('admin.back') %>">
          <%= icon_tag("arrow-left") %>
        </a>
        <h1 class="admin-header__title"><%= @path.title %></h1>
        <span class="badge <%= @path.status == 'published' ? 'badge--link' : 'badge--draft' %>"><%= @path.status %></span>
      </div>
      <div class="admin-header__actions">
        <a href="<%= path_path(@path) %>" class="admin-header__view-live link-quiet" target="_blank"><%= t("admin.view_live") %> ↗</a>
        <a href="<%= edit_admin_path_path(@path) %>" class="btn btn--small">
          <%= icon_tag "gear-six" %>
          <span><%= t("admin.builder.settings") %></span>
        </a>
      </div>
    </div>

    <p class="admin-form__hint builder__hint"><%= t("admin.builder.hint") %></p>

    <div class="builder"
         data-controller="curriculum"
         data-curriculum-lessons-url-value="<%= admin_path_lesson_moves_path(@path) %>"
         data-curriculum-courses-url-value="<%= admin_path_course_moves_path(@path) %>"
         data-curriculum-saved-text-value="<%= t('admin.builder.saved') %>"
         data-curriculum-failed-text-value="<%= t('admin.builder.save_failed') %>"
         data-action="dragstart->curriculum#dragStart dragover->curriculum#dragOver drop->curriculum#drop dragend->curriculum#dragEnd">

      <% if @courses.empty? %>
        <div class="admin-empty"><p class="admin-empty__text"><%= t("admin.builder.no_courses") %></p></div>
      <% else %>
        <ul class="builder__courses" data-curriculum-target="courseList">
          <%= render partial: "admin/paths/course", collection: @courses, as: :course, locals: { path: @path } %>
        </ul>
      <% end %>

      <a href="<%= new_admin_course_path(path_id: @path.id) %>" class="builder__add">
        <%= icon_tag "plus" %>
        <span><%= t("admin.builder.add_course") %></span>
      </a>
    </div>

    <%# The profession's team — the Adminland-style people slice, scoped to one
        map: who holds a grant, who is publicly a curator, who verified. Grants
        themselves are managed in the user card (admins only). %>
    <div class="admin-group admin-group--spaced">
      <div class="admin-group__head">
        <h2 class="admin-group__title"><%= t("admin.builder.team_title") %></h2>
        <% if Current.user.can_administer? %>
          <a href="<%= admin_users_path %>" class="btn btn--small"><%= t("admin.builder.team_grant") %></a>
        <% end %>
      </div>

      <% if @editorships.any? %>
        <div class="admin-list">
          <% @editorships.each do |editorship| %>
            <% editor = editorship.user %>
            <%= content_tag(Current.user.can_administer? ? :a : :div,
                  Current.user.can_administer? ? { href: admin_user_path(editor), class: "admin-row" } : { class: "admin-row admin-row--static" }) do %>
              <span class="admin-row__column">
                <span class="admin-row__title admin-row__title--person">
                  <%= avatar_tag(editor.name) %>
                  <%= editor.name %>
                  <% if editor.administrator? %>
                    <span class="badge badge--marker"><%= t("admin.roles.administrator") %></span>
                  <% end %>
                  <% if editor.suspended? %>
                    <span class="badge badge--draft"><%= t("admin.builder.team_suspended") %></span>
                  <% elsif !editor.can_edit_content? %>
                    <span class="badge badge--draft"><%= t("admin.builder.team_dormant") %></span>
                  <% end %>
                </span>
                <p class="admin-row__subtle">
                  <%= [ editor.headline.presence,
                        (t("admin.builder.team_public_curator") if editor.public_curator?),
                        (t("admin.builder.team_verified", date: l(@path.verified_at.to_date)) if @path.verified_by == editor && @path.verified_at) ]
                        .compact.join(" · ").presence || editor.email_address %>
                </p>
              </span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty">
          <p class="admin-empty__text"><%= t("admin.builder.team_empty") %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
