<% meta_title(t("admin.new_course")) %>

<section class="admin-page">
  <div class="container">
    <div class="admin-header">
      <div class="admin-header__title-group">
        <a href="<%= admin_courses_path %>" class="admin-header__back" aria-label="<%= t('admin.back') %>">
          <%= icon_tag("arrow-left") %>
        </a>
        <h1 class="admin-header__title"><%= t("admin.new_course") %></h1>
      </div>
    </div>

    <%= render "admin/courses/form", course: @course, editable_paths: @editable_paths %>
  </div>
</section>
