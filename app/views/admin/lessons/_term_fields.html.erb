<div class="term-row" data-nested-form-target="item">
  <div class="term-row__head">
    <%= f.text_field :abbr, placeholder: t("admin.terms.abbr_placeholder"),
          maxlength: 40, class: "input input--mono term-row__abbr" %>
    <%= f.text_field :full, placeholder: t("admin.terms.full_placeholder"),
          maxlength: 200, class: "input term-row__full" %>
    <%= f.text_field :analog, placeholder: t("admin.terms.analog_placeholder"),
          maxlength: 40, class: "input input--mono term-row__analog",
          title: t("admin.terms.analog_hint") %>
    <button type="button" class="term-row__remove" data-action="nested-form#removeItem"
            aria-label="<%= t("admin.terms.remove") %>">
      <%= icon_tag "trash" %>
    </button>
  </div>
  <%# Ghost field: placeholder is the whole manual, frame returns on focus. %>
  <%= f.text_field :note, placeholder: t("admin.terms.note_placeholder"),
        maxlength: 200, class: "input input--ghost term-row__note" %>
  <%= f.hidden_field :_destroy, data: { nested_form_target: "destroy" } %>
</div>
