<%# One editable resource row. `f` is a fields_for builder for a Resource.
    Two compact lines: kind badge + select + title + controls, then the URL. %>
<div class="resource-row" data-nested-form-target="item">
  <button type="button" class="resource-row__handle" draggable="true"
          aria-label="<%= t("admin.resources.reorder") %>"
          data-action="dragstart->nested-form#dragStart dragend->nested-form#dragEnd">
    <%= icon_tag "list" %>
  </button>

  <div class="resource-row__fields">
    <div class="resource-row__head">
      <%# The kind's colour compressed to a dot — the select carries the word,
          so the reader-facing hue survives without saying "Норматив" twice. %>
      <span class="resource-row__dot" data-nested-form-target="badge"></span>
      <%= f.select :kind,
            Resource::KINDS.map { |k| [ t("lessons.resource_kinds.#{k}"), k ] },
            {}, class: "input resource-row__kind",
            data: { nested_form_target: "kind", action: "nested-form#refreshBadge" } %>
      <%= f.text_field :title, placeholder: t("admin.resources.title_placeholder"),
            class: "input resource-row__title" %>
      <button type="button" class="resource-row__remove" data-action="nested-form#removeItem"
              aria-label="<%= t("admin.resources.remove") %>">
        <%= icon_tag "trash" %>
      </button>
    </div>

    <%= f.url_field :url, placeholder: "https://", class: "input input--mono resource-row__url" %>

    <%# Quiet bottom line: the ghost note plus the two flag checkboxes — moved
        off the head row so the title gets its full width. %>
    <div class="resource-row__foot">
      <%# Ghost field: renders like the muted note line the reader gets, so the
          editor sees what the text is for; the frame returns on focus. The
          placeholder IS the whole manual — the worked example lives in /guide. %>
      <%= f.text_field :note, placeholder: t("admin.resources.note_placeholder"),
            maxlength: 200, class: "input input--ghost resource-row__note" %>
      <%# One-click language marker: checked = English source, unchecked = Russian
          (default). Only EN exists, so a checkbox beats a two-click select. %>
      <label class="resource-row__lang" title="<%= t('lessons.resource_languages.en') %>">
        <%= f.check_box :language, {}, "en", "" %>
        <span>EN</span>
      </label>
      <label class="resource-row__required">
        <%= f.check_box :required %>
        <span><%= t("admin.resources.required") %></span>
      </label>
    </div>
  </div>

  <%= f.hidden_field :position, data: { nested_form_target: "position" } %>
  <%= f.hidden_field :_destroy, data: { nested_form_target: "destroy" } %>
</div>
