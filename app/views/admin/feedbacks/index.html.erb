<% meta_title(t("admin.manage_feedbacks")) %>

<section class="admin-page">
  <div class="container">
    <%= render "admin/shared/nav" %>

    <div class="admin-header">
      <div class="admin-header__title-group admin-header__title-group--stacked">
        <h1 class="admin-header__title"><%= t("admin.manage_feedbacks") %></h1>
        <% if @coauthor_only %>
          <p class="admin-header__subtitle">
            <%= t("admin.coauthor_approve.filter_note") %>
            · <%= link_to t("admin.coauthor_approve.filter_reset"), admin_feedbacks_path, class: "link-quiet" %>
          </p>
        <% end %>
      </div>
    </div>

    <% if @feedbacks.none? %>
      <div class="admin-empty">
        <p class="admin-empty__text"><%= t("admin.feedbacks_none") %></p>
      </div>
    <% else %>
      <%# Dense inbox: a compact row per message, full text on click (native
          <details>, no JS) so a long queue stays scannable. %>
      <ul class="inbox">
        <% @feedbacks.each do |feedback| %>
          <li class="inbox__item">
            <details class="inbox__entry">
              <summary class="inbox__summary">
                <span class="inbox__from"><%= feedback.user&.name || t("admin.feedback_guest") %></span>
                <span class="inbox__snippet"><%= truncate(feedback.body.to_s.squish, length: 100) %></span>
                <time class="inbox__date" datetime="<%= feedback.created_at.iso8601 %>">
                  <%= l(feedback.created_at, format: :short) %>
                </time>
              </summary>

              <div class="inbox__detail">
                <p class="inbox__meta">
                  <% if feedback.user %>
                    <%= mail_to feedback.user.email_address, feedback.user.email_address, class: "link-quiet" %>
                    ·
                  <% end %>
                  <%= l(feedback.created_at, format: :long) %>
                  <% if feedback.page_url.present? %>
                    · <%= link_to t("admin.feedback_from_page"), feedback.page_url, class: "link-quiet" %>
                  <% end %>
                </p>
                <div class="inbox__body"><%= simple_format(feedback.body) %></div>

                <%# Coauthor application → one-gesture approval: confirm the
                    profession name, and role + draft + editorship land together. %>
                <% if feedback.coauthor_application? && feedback.user %>
                  <div class="inbox__approve panel">
                    <p class="inbox__approve-label"><%= t("admin.coauthor_approve.label") %></p>
                    <%= form_with url: admin_feedback_coauthor_approval_path(feedback), method: :post, class: "inbox__approve-form" do %>
                      <%= text_field_tag :profession_title, feedback.suggested_profession,
                            placeholder: t("admin.coauthor_approve.placeholder"),
                            class: "input", required: true, aria: { label: t("admin.coauthor_approve.placeholder") } %>
                      <%= submit_tag t("admin.coauthor_approve.submit"), class: "btn btn--small btn--reversed",
                            data: { turbo_confirm: t("admin.coauthor_approve.confirm") } %>
                    <% end %>
                    <p class="inbox__approve-hint"><%= t("admin.coauthor_approve.hint") %></p>
                  </div>
                <% end %>

                <% if feedback.user %>
                  <a href="mailto:<%= feedback.user.email_address %>?subject=<%= u t('admin.feedback_reply_subject') %>"
                     class="btn btn--small btn--reversed">
                    <%= t("admin.feedback_reply") %>
                  </a>
                <% end %>
              </div>
            </details>
          </li>
        <% end %>
      </ul>

      <%= render "admin/shared/pagination", page: @page, more: @has_more %>
    <% end %>
  </div>
</section>
