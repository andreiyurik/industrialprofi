<% meta_title(t("admin.illustrations.title")) %>

<section class="admin-page">
  <div class="container">
    <%= render "admin/shared/nav" %>

    <div class="admin-header">
      <div class="admin-header__title-group">
        <h1 class="admin-header__title"><%= t("admin.illustrations.title") %></h1>
        <p class="admin-header__subtitle"><%= t("admin.illustrations.intro") %></p>
      </div>
    </div>

    <% if @groups.empty? %>
      <div class="admin-empty">
        <p class="admin-empty__text"><%= t("admin.illustrations.empty") %></p>
      </div>
    <% else %>
      <p class="admin-list__summary">
        <%= t("admin.illustrations.summary", count: @pending_count, lessons: @lesson_count) %>
      </p>

      <% @groups.each do |path, rows| %>
        <div class="admin-group">
          <h2 class="admin-group__title"><%= path.title %></h2>
          <div class="admin-list">
            <% rows.each do |row| %>
              <% row[:briefs].each do |brief| %>
                <div class="admin-row admin-row--static">
                  <span class="admin-row__column">
                    <span class="admin-row__line">
                      <span class="admin-row__title"><%= row[:lesson].title %></span>
                    </span>
                    <p class="admin-row__subtle">
                      <%= brief.presence || t("admin.illustrations.no_brief") %>
                    </p>
                  </span>
                  <div class="admin-row__actions">
                    <%= link_to t("admin.illustrations.fill"),
                          edit_admin_lesson_path(row[:lesson]),
                          class: "btn btn--small admin-row__action" %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
