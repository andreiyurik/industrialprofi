<% meta_title("#{@lesson.title} — #{@path.title}") %>
<% meta_description(@lesson.description.to_s.truncate(160)) %>
<% canonical_url(lesson_url(@lesson)) %>
<% content_for(:og_type, "article") %>

<% content_for(:head) do %>
  <%# Crawler-only freshness signal, pairs with the JSON-LD dateModified and sitemap <lastmod>. %>
  <meta property="article:published_time" content="<%= @lesson.created_at.iso8601 %>">
  <meta property="article:modified_time" content="<%= @lesson.updated_at.iso8601 %>">
  <%= json_ld_tag(learning_resource_json_ld(@lesson)) %>
  <%= json_ld_tag(breadcrumb_json_ld([
    { title: t("breadcrumbs.home"), url: "#{site_config.url}/" },
    { title: t("paths.title"), url: "#{site_config.url}/paths" },
    { title: @path.title, url: "#{site_config.url}/paths/#{@path.slug}" },
    { title: @course.title, url: "#{site_config.url}/courses/#{@course.slug}" },
    { title: @lesson.title, url: "#{site_config.url}/lessons/#{@lesson.slug}" }
  ])) %>
<% end %>

<%# reading_mode cookie renders the stripped layout server-side, so switching lessons never flashes the chrome. %>
<div class="lesson-layout<%= " lesson-layout--reading" if cookies[:reading_mode] == "1" %>"
     data-controller="lesson-sidebar reading-mode"
     data-lesson-sidebar-open-class="lesson-layout--sidebar-open"
     data-reading-mode-active-class="lesson-layout--reading"
     data-action="keydown.esc@window->lesson-sidebar#close keydown.esc@window->reading-mode#exit">
  <%= render "lessons/sidebar", course: @course, current_lesson: @lesson,
        lessons_by_stage: @lessons_by_stage, completed_ids: @completed_ids %>

  <div class="lesson-sidebar-backdrop" data-action="click->lesson-sidebar#close" aria-hidden="true"></div>

  <%# --fillable reveals fill links baked hidden into the shared cached HTML; set per-request, outside the cache. %>
  <div class="lesson<%= " lesson--fillable" if Current.user&.can_edit_path?(@lesson.path) %>">
  <% if @preview %>
    <p class="lesson__preview-banner"><%= t("lessons.preview_banner") %></p>
  <% end %>
  <%# Trail stops at the course — the <h1> below already names the lesson; full path is in the breadcrumb JSON-LD for SEO. %>
  <%# Copy/reading-mode buttons render `hidden` and are revealed by their controllers on connect — no dead buttons without JS. %>
  <div class="lesson__topbar"
       data-controller="copy-link"
       data-copy-link-url-value="<%= "#{site_config.url}/lessons/#{@lesson.slug}" %>"
       data-copy-link-label-value="<%= t("lessons.copy_link") %>"
       data-copy-link-copied-value="<%= t("lessons.link_copied") %>"
       data-copy-link-copied-class="lesson__copy--copied">
    <div class="lesson__trail">
      <button type="button" class="lesson-contents-toggle" data-action="lesson-sidebar#open"
              title="<%= t("lessons.sidebar_label") %>">
        <%= icon_tag "list" %>
        <%= t("lessons.contents") %>
      </button>
      <%= render "shared/breadcrumbs", crumbs: [
        { title: @path.title, path: path_path(@path) },
        { title: @course.title, path: course_path(@course) }
      ] %>
    </div>

    <div class="lesson__tools">
      <%# Shown only to users who can edit this path, so the link never lands on a 403. %>
      <% if Current.user&.can_edit_path?(@lesson.path) %>
        <%= link_to edit_admin_lesson_path(@lesson), class: "lesson__tool lesson__edit",
              aria: { label: t("lessons.edit_lesson") }, title: t("lessons.edit_lesson") do %>
          <%= icon_tag "pencil-simple" %>
        <% end %>
      <% end %>

      <%# Always public, no can_edit? gate — guests and crawlers can reach history too. %>
      <% history_title = t("revisions.history_updated", date: l(@lesson.updated_at.to_date)) %>
      <%= link_to lesson_revisions_path(@lesson), class: "lesson__tool",
            aria: { label: t("revisions.history") }, title: history_title do %>
        <%= icon_tag "clock" %>
      <% end %>

      <%# Bookmarkable on every lesson type, not just practice — theory gets revisited too. %>
      <% if signed_in? %>
        <%= render "lessons/bookmark_button", lesson: @lesson,
              bookmarked: Current.user.lesson_bookmarks.exists?(lesson: @lesson) %>
      <% end %>

      <button type="button" class="lesson__tool lesson__copy" hidden
              data-copy-link-target="button"
              data-action="copy-link#copy"
              aria-label="<%= t("lessons.copy_link") %>" title="<%= t("lessons.copy_link") %>">
        <span class="lesson__copy-icon lesson__copy-icon--default"><%= icon_tag "link" %></span>
        <span class="lesson__copy-icon lesson__copy-icon--done"><%= icon_tag "check" %></span>
        <span class="for-screen-reader" data-copy-link-target="label"><%= t("lessons.copy_link") %></span>
      </button>

      <%# Icon-only in both states; the for-screen-reader state text is the only label — sighted users get title + Esc. %>
      <button type="button" class="lesson__tool lesson-reading-toggle" hidden
              data-reading-mode-target="toggle"
              data-action="reading-mode#toggle"
              title="<%= t("lessons.reading_mode") %>">
        <span class="lesson-reading-toggle__enter">
          <%= icon_tag "book-open" %>
          <span class="for-screen-reader"><%= t("lessons.reading_mode") %></span>
        </span>
        <span class="lesson-reading-toggle__exit">
          <%= icon_tag "x" %>
          <span class="for-screen-reader"><%= t("lessons.reading_mode_exit") %></span>
        </span>
      </button>
    </div>
  </div>

  <header class="lesson__header">
    <h1 class="lesson__title"><%= @lesson.title %></h1>
  </header>

  <article data-controller="lightbox">
    <% if @lesson.has_description? %>
      <section id="why" class="lesson__intro">
        <p class="lesson__intro-label"><%= t("lessons.why_section") %></p>
        <div class="prose"><%= lesson_content(@lesson, :description) %></div>
        <%= render "lessons/edit_link", section: "description" %>
      </section>
    <% end %>

    <% if @lesson.has_body? %>
      <%# No heading here — lesson bodies open with their own ##; the id stays for the sidebar TOC anchor. %>
      <section id="study" class="lesson__section">
        <div class="prose"><%= lesson_content(@lesson, :body) %></div>
        <%= render "lessons/edit_link", section: "body" %>
      </section>
    <% end %>

    <%# Always rendered, even with zero resources — the empty state is the contribution seam readers need most. %>
    <%# Partition preloaded resources in Ruby — the .required/.optional scopes would drop the controller's eager load and re-query. %>
    <% required_resources, optional_resources = @lesson.resources.to_a.partition(&:required?) %>
    <% can_edit_resources = Current.user&.can_edit_path?(@lesson.path) %>
    <section id="resources" class="lesson__section lesson__section--plain">
      <div class="resource-block<%= " resource-block--empty" unless @lesson.has_resources? %>">
        <div class="resource-block__head">
          <span class="resource-block__icon"><%= icon_tag "file-text" %></span>
          <h2 class="resource-block__title"><%= t("lessons.resources_section") %></h2>
          <% if can_edit_resources && @lesson.has_resources? %>
            <%= link_to edit_admin_lesson_path(@lesson, anchor: "resources-editor"),
                  class: "lesson__tool resource-block__edit",
                  aria: { label: t("lessons.edit_resources") }, title: t("lessons.edit_resources") do %>
              <%= icon_tag "pencil-simple" %>
            <% end %>
          <% end %>
        </div>

        <% if required_resources.any? %>
          <h3 class="resource-block__group"><%= t("lessons.required_group") %></h3>
          <ul class="lesson-resources">
            <%= render required_resources %>
          </ul>
        <% end %>

        <% if optional_resources.any? %>
          <h3 class="resource-block__group"><%= t("lessons.optional_group") %></h3>
          <ul class="lesson-resources">
            <%= render optional_resources %>
          </ul>
        <% end %>

        <% unless @lesson.has_resources? %>
          <p class="resource-block__empty"><%= t("resource_suggestions.block_empty") %></p>
        <% end %>

        <%# Explicit way in for editors on a sourceless lesson — the topbar pencil alone is easy to miss. %>
        <% if can_edit_resources %>
          <% unless @lesson.has_resources? %>
            <%= link_to edit_admin_lesson_path(@lesson, anchor: "resources-editor"),
                  class: "resource-block__suggest" do %>
              <%= icon_tag "plus-circle" %>
              <span class="resource-block__suggest-label"><%= t("lessons.edit_resources") %></span>
            <% end %>
          <% end %>
        <% else %>
          <%= render "lessons/suggest_resource_link", lesson: @lesson %>
        <% end %>
      </div>
    </section>

    <%= render "lessons/calculators", lesson: @lesson %>

    <% if @lesson.has_task? %>
      <section id="task" class="lesson__section">
        <h2 class="lesson__heading lesson__heading--task">
          <%= icon_tag "wrench" %>
          <span><%= t("lessons.task_section") %></span>
        </h2>
        <div class="lesson__task">
          <div class="prose"><%= lesson_content(@lesson, :task) %></div>
          <% if @lesson.practice? && signed_in? %>
            <%= link_to new_journal_entry_path(lesson_id: @lesson.id), class: "btn lesson-task-journal" do %>
              <%= icon_tag "pencil-simple" %>
              <%= t("lessons.log_result") %>
            <% end %>
            <% if @my_journal_entries.any? %>
              <div class="lesson-task-entries">
                <p class="lesson-task-entries__title"><%= t("lessons.journal_entries_title") %></p>
                <ul class="lesson-task-entries__list">
                  <% @my_journal_entries.each do |entry| %>
                    <li>
                      <%= link_to journal_entries_path, class: "link-quiet link-quiet--underline" do %><%= l(entry.created_at.to_date) %><% if entry.title.present? %> — <%= entry.title %><% end %><% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          <% end %>
        </div>
        <%= render "lessons/edit_link", section: "task" %>
      </section>
    <% end %>

    <%= render "lessons/completion", lesson: @lesson, completed: @completed_ids.include?(@lesson.id) %>
    <%= render "lessons/attribution", lesson: @lesson %>
  </article>
  </div>

  <%= render "lessons/toc", lesson: @lesson %>
</div>

<section class="support-cta">
  <div class="container support-cta__inner">
    <h2 class="support-cta__title"><%= t("support_cta.title") %></h2>
    <p class="support-cta__subtitle"><%= t("support_cta.subtitle") %></p>
    <div class="support-cta__buttons">
      <%= link_to t("support_cta.contact_us"), support_us_path, class: "btn" %>
      <a href="<%= site_config.donate_url %>" class="btn btn--reversed" target="_blank" rel="noopener"><%= t("support_cta.donate") %></a>
    </div>
  </div>
</section>
