<div class="calc__grid">
  <div class="calc__inputs">
    <h2 class="calc__heading"><%= t("calculators.inputs_heading") %></h2>
    <%# Открываем на микро 4/3: на полном кадре коэффициент равен 1 и калькулятор
        не показывает того, ради чего существует. %>
    <%= render "calculators/format_select", selected: "m43" %>
    <div class="calc__row">
      <%= render "calculators/field", field: "f", label: t("calculators.fields.focal"), unit: "мм", value: 25 %>
      <%= render "calculators/field", field: "n", label: t("calculators.fields.aperture"), unit: "f/", value: 1.7 %>
    </div>
  </div>

  <div class="calc__results">
    <h2 class="calc__heading"><%= t("calculators.results_heading") %></h2>
    <%= render "calculators/answer", output: "feq", label: t("calculators.crop-factor.result_feq"), unit: "мм" %>
    <%= render "calculators/result", output: "neq", label: t("calculators.crop-factor.result_neq"), unit: "f/",
          info: t("calculators.crop-factor.info.neq") %>
    <%= render "calculators/result", output: "noise", label: t("calculators.crop-factor.result_noise"),
          info: t("calculators.crop-factor.info.noise") %>
    <%= render "calculators/result", output: "fov", label: t("calculators.crop-factor.result_fov"), unit: "°" %>
    <p class="calc__note"><%= t("calculators.crop-factor.note") %></p>
  </div>
</div>
