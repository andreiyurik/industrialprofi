<%# A labelled input. locals: field, label; optional: unit, value, hint, info ("?" popover), text (string input, e.g. an IP),
    slider ({ min:, max:, step: } — a range that mirrors this input; only the number carries data-field, see calculator_controller),
    presets (array of [value, text] — a "typical values" select that fills this input; likewise never a field of its own) %>
<label class="calc-field">
  <span class="calc-field__label">
    <%= label %><% if local_assigns[:info].present? %><%= render "calculators/term_info", id: "info-#{field}", text: info %><% end %>
    <% if local_assigns[:hint].present? %><span class="calc-field__hint"><%= hint %></span><% end %>
  </span>
  <% if local_assigns[:presets].present? %>
    <select class="input calc-field__presets" data-preset-for="<%= field %>" aria-label="<%= t("calculators.preset_label", quantity: label) %>">
      <option value=""><%= t("calculators.preset_custom") %></option>
      <% presets.each do |value, text| %>
        <%= tag.option text, value: value, selected: local_assigns[:value].to_s == value.to_s %>
      <% end %>
    </select>
  <% end %>
  <span class="calc-field__control">
    <%= tag.input type: "text", inputmode: local_assigns[:text] ? "text" : "decimal", autocomplete: "off",
          class: "input calc-field__input", data: { field: field, text: ("" if local_assigns[:text]) },
          value: calculator_value(local_assigns[:value]) %>
    <% if local_assigns[:unit].present? %>
      <span class="calc-field__unit"><%= unit %></span>
    <% end %>
  </span>
  <% if local_assigns[:slider].present? %>
    <input type="range" class="calc-field__range" data-range-for="<%= field %>" tabindex="-1"
           min="<%= slider[:min] %>" max="<%= slider[:max] %>" step="<%= slider[:step] %>"
           value="<%= local_assigns[:value] %>" aria-hidden="true">
  <% end %>
</label>
