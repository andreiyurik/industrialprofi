<%# Числа примеров сверены с реальным выводом калькуляторов, не придуманы. %>
<% steps = t("calculators.#{calculator.slug}.method.steps", default: []) %>
<% if steps.any? %>
  <section class="calc-method">
    <h2 class="calc-method__title"><%= t("calculators.method_heading") %></h2>

    <ol class="calc-method__steps">
      <% steps.each do |step| %>
        <li><%= step %></li>
      <% end %>
    </ol>

    <% example = t("calculators.#{calculator.slug}.method.example", default: nil) %>
    <% if example.present? %>
      <p class="calc-method__example">
        <span class="calc-method__example-label"><%= t("calculators.method_example") %></span>
        <%= example %>
      </p>
    <% end %>

    <% table = "calculators/tables/#{calculator.slug}" %>
    <%= render table, calculator: calculator if lookup_context.template_exists?(table, [], true) %>
  </section>
<% end %>
