<%# Outcome is said in words, not only colour — a colour-blind eye or a screen reader gets nothing from colour alone. %>
<p class="calc-verdict" data-verdict data-status=""
   data-verdict-ok="<%= ok %>" data-verdict-warn="<%= warn %>"
   data-verdict-idle="<%= t("calculators.verdict_idle") %>">
  <span class="calc-verdict__mark calc-verdict__mark--ok"><%= icon_tag "check-circle" %></span>
  <span class="calc-verdict__mark calc-verdict__mark--warn"><%= icon_tag "warning" %></span>
  <span class="calc-verdict__text" data-verdict-text><%= t("calculators.verdict_idle") %></span>
</p>
