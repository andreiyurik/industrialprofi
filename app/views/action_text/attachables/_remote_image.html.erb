<%# Override of ActionText's core partial: a missing asset renders a calm placeholder
    instead of raising Propshaft::MissingAssetError and 500-ing the lesson. %>
<% diagram = Diagram.slug(remote_image.node["url"]) %>
<% if diagram || pending_remote_image?(remote_image) %>
  <%# A bare img: later passes turn it into the diagram or the pending box with the fill link. %>
  <%= tag.img src: Lesson.encode_placeholder(Lesson.decode_placeholder(remote_image.node["url"])), alt: remote_image.caption %>
  <% if diagram && remote_image.caption.present? %><em><%= remote_image.caption %></em><% end %>
<% else %>
  <figure class="attachment attachment--preview">
    <%= safe_remote_image_tag(remote_image) %>
    <% if caption = remote_image.try(:caption) %>
      <figcaption class="attachment__caption"><%= caption %></figcaption>
    <% end %>
  </figure>
<% end %>
