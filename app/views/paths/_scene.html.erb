<%# locals: (scene:, courses:) -%>
<%# Steps run clockwise from the bottom-left corner; a node opens its chapter when that chapter is published. %>
<% chapters = courses.reject(&:coming_soon?).index_by(&:slug) %>
<% first, second, third, fourth = scene.steps %>
<% to_second, to_third, to_fourth, to_first = scene.links %>
<figure class="scene">
  <div class="scene__loop">
    <% if scene.top.name.present? %>
      <%= scene_node scene.top, :top, chapters %>
      <%= scene_wire :rise, :up, scene.top_link %>
    <% end %>
    <%= scene_node second, :second, chapters %>
    <%= scene_wire :across, :right, to_third %>
    <%= scene_node third, :third, chapters %>
    <%= scene_wire :climb, :up, to_second %>
    <%= scene_wire :drop, :down, to_fourth %>
    <%= scene_node first, :first, chapters %>
    <%= scene_wire :back, :left, to_first %>
    <%= scene_node fourth, :fourth, chapters %>
  </div>
  <% if scene.caption.present? %>
    <figcaption class="scene__caption"><%= scene.caption %></figcaption>
  <% end %>
</figure>
