<%# The maturity ladder — «насколько зрелая эта карта» for a newcomer, a call
    to action for a contributor. The hero keeps only a quiet centered line (the
    poster stays symmetric; the learner's own progress bar below keeps the sole
    meter on the page); the full Basecamp-style needle lives in the popover,
    where the checklist explains it — and re-sweeps on every open. Rung 4 is
    hand-set there by the map's own editors («move the needle»), never computed. %>
<% stage = path.maturity_stage %>
<div class="maturity maturity--stage-<%= stage %>">
  <button type="button" class="maturity__line" popovertarget="path-maturity">
    <span class="maturity__dot" aria-hidden="true"></span>
    <%= t(".popover_title", stage: stage, total: Path::Maturity::MATURITY_STAGES) %> · <%= t(".stages.s#{stage}") %>
  </button>

  <div id="path-maturity" class="maturity-popover" popover>
    <svg class="maturity__gauge" viewBox="0 0 200 96" aria-hidden="true"
         style="--gauge-angle: <%= maturity_needle_angle(stage) %>deg">
      <% maturity_gauge_segments(stage).each do |segment| %>
        <path d="<%= segment[:d] %>" <% if segment[:filled] %>class="is-filled"<% end %> />
      <% end %>
      <g class="maturity__needle">
        <rect x="-3.5" y="-98.5" width="7" height="25" rx="3.5" transform="translate(100 104)"/>
      </g>
    </svg>

    <header class="maturity-popover__header">
      <p class="maturity-popover__title"><%= t(".stages.s#{stage}") %></p>
      <p class="maturity-popover__subtitle"><%= t(".popover_title", stage: stage, total: Path::Maturity::MATURITY_STAGES) %> · <%= path.title %></p>
    </header>

    <% checks = [
         [ true, t(".crit_draft", count: path.lessons_count) ],
         [ path.community_improved?,
           path.community_improved? ? t(".crit_edits", count: path.approved_suggestions_count) : t(".crit_edits_todo") ],
         [ path.curated?,
           if curators.any?
             t(".crit_curator", names: curators.map(&:name).to_sentence)
           else
             path.curated? ? t(".crit_curator_anon") : t(".crit_curator_todo")
           end ],
         [ path.verified?,
           if path.verified?
             t(".crit_verified", date: l(path.verified_at.to_date))
           elsif path.verification_expired?
             t(".crit_verified_expired", date: l(path.verified_at.to_date))
           else
             t(".crit_verified_todo")
           end ]
       ] %>
    <ul class="maturity-popover__list" role="list">
      <% checks.each do |done, text| %>
        <li class="<%= done ? "is-done" : "is-todo" %>">
          <%= heroicon done ? "check-circle" : "minus-circle", variant: :outline %>
          <span><%= text %></span>
        </li>
      <% end %>
    </ul>

    <div class="maturity-popover__actions">
      <%= link_to t(".improve"), contribute_path, class: "btn btn--small" %>
      <% if signed_in? && Current.user.can_edit_path?(path) %>
        <% if path.verified? %>
          <%= button_to t(".unverify"), admin_path_verification_path(path), method: :delete, class: "btn btn--small" %>
        <% else %>
          <%= button_to t(".verify"), admin_path_verification_path(path), class: "btn btn--small btn--reversed" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
