<% meta_title(t("paths.practice.title", profession: @path.title)) %>
<% meta_description(t("paths.practice.description", profession: @path.title)) %>
<% canonical_url(path_practice_url(@path)) %>

<% content_for(:head) do %>
  <%= json_ld_tag(breadcrumb_json_ld([
    { title: t("breadcrumbs.home"), url: "#{site_config.url}/" },
    { title: t("paths.title"), url: "#{site_config.url}/paths" },
    { title: @path.title, url: "#{site_config.url}/paths/#{@path.slug}" },
    { title: t("paths.hub.practice"), url: "#{site_config.url}/paths/#{@path.slug}/practice" }
  ])) %>
<% end %>

<section class="section">
  <div class="container container--reading">
    <%= render "paths/hub_header", path: @path, progress: @progress, curators: @path.hub_curators.to_a, tab: :practice %>

    <section class="hub-section">
      <div class="hub-section__head">
        <h2 class="hub-section__title"><%= t("paths.practice.heading") %></h2>
        <p class="hub-section__meta">
          <%= t("projects.tasks", count: @total_tasks) %>
          <%# The one control: the save-for-later view for signed-in readers, a
              quiet link beside the count. Levels need no filter — they ARE the
              groups below. %>
          <% if signed_in? && @total_tasks.positive? %>
            ·
            <%= link_to t("projects.saved_filter"), path_practice_path(@path, saved: @saved_only ? nil : "1"),
                        class: "hub-section__toggle", "aria-current": @saved_only || nil %>
          <% end %>
        </p>
      </div>

      <% if @groups.any? %>
        <%# A to-do list, Basecamp's own pattern: one list per level, a round
            checkbox on every task, the done ones ticked and struck through.
            Deliberately unlike the chapter page's rail-and-panels — the eye
            should tell «practice» from «theory» before reading a word. %>
        <div class="todo">
          <% @groups.each do |difficulty, tasks| %>
            <% done_count = tasks.count { |task| @progress.completed?(task) } %>
            <section class="todo__list">
              <header class="todo__head">
                <h3 class="todo__title">
                  <%= render "shared/difficulty_mark", difficulty: difficulty, sr_label: false, tooltip: false %>
                  <span><%= t("lessons.difficulty.#{difficulty}") %></span>
                  <span class="todo__hint"><%= t("projects.difficulty_hints.#{difficulty}") %></span>
                </h3>
                <% if done_count.positive? %>
                  <span class="todo__count<%= " todo__count--complete" if done_count == tasks.size %>"><%= t("projects.group_progress", done: done_count, total: tasks.size) %></span>
                <% end %>
              </header>
              <ul class="todo__items" role="list">
                <% tasks.each do |task| %>
                  <%= render "shared/todo_item", lesson: task, done: @progress.completed?(task),
                        bookmarked: @bookmarked_ids.include?(task.id), meta: nil %>
                <% end %>
              </ul>
            </section>
          <% end %>
        </div>
      <% elsif @saved_only %>
        <p class="projects__empty">
          <%= t("projects.empty_saved") %>
          <%= link_to t("projects.reset_filters"), path_practice_path(@path) %>
        </p>
      <% else %>
        <p class="projects__empty"><%= t("projects.empty") %></p>
      <% end %>
    </section>

    <%= render "paths/improve" %>
  </div>
</section>
