<% meta_title(@path.title) %>
<% meta_description(@path.description.to_s.truncate(160)) %>
<% canonical_url(path_url(@path)) %>
<%# locale: nil — the storage routes live outside the locale scope, and the
    helper would otherwise append a stray ?locale= to the share image URL. %>
<% if @path.cover.attached? %>
  <% content_for(:og_image, ApplicationHelper.variant_processing_available? ?
       rails_representation_url(@path.cover.variant(resize_to_fill: [ 1200, 630 ], format: :webp), locale: nil) :
       rails_blob_url(@path.cover, locale: nil)) %>
<% end %>

<% content_for(:head) do %>
  <%= json_ld_tag(course_json_ld(@path)) %>
  <%= json_ld_tag(breadcrumb_json_ld([
    { title: t("breadcrumbs.home"), url: "#{site_config.url}/" },
    { title: t("paths.title"), url: "#{site_config.url}/paths" },
    { title: @path.title, url: "#{site_config.url}/paths/#{@path.slug}" }
  ])) %>
<% end %>

<section class="section">
  <div class="container container--reading">
    <%= render "paths/hub_header", path: @path, progress: @progress, curators: @path.hub_curators.to_a, tab: :overview %>

    <%= render "shared/continue_cta", continue_lesson: @progress.next_lesson, completed_ids: @progress.completed_ids %>

    <%# The story (the slots an author filled — nothing when none), then the
        chapter outline; the programme itself is the «Теория» tab. %>
    <%= render "paths/landing", path: @path %>
    <%= render "paths/outline", path: @path, courses: @courses, kind_counts: @kind_counts %>

    <%= render "paths/improve" %>
  </div>
</section>

<%= render "shared/support_cta" %>
