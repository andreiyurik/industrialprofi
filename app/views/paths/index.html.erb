<% canonical_url("#{site_config.url}/") %>

<% content_for(:head) do %>
  <%= json_ld_tag(website_json_ld) %>
  <%= json_ld_tag(organization_json_ld) %>
<% end %>

<% available, upcoming = @paths.partition { |path| !path.stub? } %>

<section class="hero">
  <div class="container hero__inner">
    <h1 class="hero__title is-caret"><%= t("paths.hero.title") %></h1>
    <p class="hero__subtitle"><%= t("paths.hero.subtitle") %></p>
  </div>
</section>

<section class="section home-catalog">
  <div class="container">
    <% if @focus_path %>
      <div class="panel focus-banner">
        <span class="focus-banner__text">
          <%= t("paths.focus_banner_html", title: link_to(@focus_path.title, path_path(@focus_path), class: "focus-banner__link")) %>
        </span>
        <% if @focus_next_lesson %>
          <%= link_to @focus_next_lesson, class: "btn btn--small btn--reversed" do %>
            <%= t("dashboard.continue") %>
            <%= heroicon "arrow-right", variant: :outline %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="catalog-grid" id="catalog">
      <% available.each do |path| %>
        <%= render "path_card", path: path,
              completed_count: @completed_counts.fetch(path.id, 0),
              courses_count: @course_counts.fetch(path.id, 0) %>
      <% end %>
    </div>

    <%# Not a roadmap — an open invitation. The unbuilt professions are a flat,
        equal list (no status dots, no highlighting): each one is waiting for an
        expert to author it. The call to become that curator is the focus. %>
    <div class="catalog-soon">
      <% if upcoming.any? %>
        <h2 class="catalog-soon__label"><%= t("paths.group_upcoming") %></h2>
        <p class="catalog-soon__lead"><%= t("paths.soon_lead") %></p>
        <p class="catalog-soon__list">
          <% upcoming.each do |path| %>
            <%= link_to path.title, contribute_path, class: "catalog-soon__slot" %>
          <% end %>
        </p>
      <% end %>
      <p class="catalog-soon__call">
        <%= link_to contribute_path, class: "btn" do %>
          <%= t("paths.soon_curator") %>
          <%= heroicon "arrow-right", variant: :outline %>
        <% end %>
      </p>
      <p class="catalog-soon__suggest">
        <%= link_to t("paths.soon_idea"), new_feedback_path(about: "profession", from: paths_path), class: "catalog-soon__cta" %>
      </p>
    </div>
  </div>
</section>
