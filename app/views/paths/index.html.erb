<% canonical_url("#{site_config.url}/") %>

<% content_for(:head) do %>
  <%= json_ld_tag(website_json_ld) %>
  <%= json_ld_tag(organization_json_ld) %>
<% end %>

<% available, upcoming = @paths.partition { |path| !path.stub? } %>

<section class="section">
  <div class="container">
    <div class="txt-align-center">
      <h1 class="section-title"><%= t("paths.title") %></h1>
      <p class="section-subtitle"><%= t("paths.subtitle") %></p>
      <p class="catalog-stats"><%= t("paths.stats_professions", count: available.size) %> · <%= russian_pluralize(available.sum(&:lessons_count), :lesson) %> · <%= t("paths.stats_free") %></p>
    </div>

    <% if @focus_path %>
      <div class="panel focus-banner">
        <span class="focus-banner__text">
          <%= t("paths.focus_banner_html", title: link_to(@focus_path.title, path_path(@focus_path), class: "focus-banner__link")) %>
        </span>
        <% if @focus_next_lesson %>
          <%= link_to @focus_next_lesson, class: "btn btn--small btn--reversed" do %>
            <%= t("dashboard.continue") %>
            <%= heroicon "arrow-right", variant: :outline %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="catalog-grid">
      <% available.each do |path| %>
        <%= render "path_card", path: path,
              completed_count: @completed_counts.fetch(path.id, 0),
              courses_count: @course_counts.fetch(path.id, 0) %>
      <% end %>
    </div>

    <%# The unbuilt whispers: a quiet line-list, never a grid of dead cards —
        a catalog of promises reads as an empty catalog. Filled dot = being
        built, hollow dot = planned. %>
    <div class="catalog-soon">
      <% if upcoming.any? %>
        <h2 class="catalog-group__label"><%= t("paths.group_upcoming") %></h2>
        <p class="catalog-soon__list">
          <% upcoming.each do |path| %>
            <span class="catalog-soon__item<%= " catalog-soon__item--active" if path.coming_soon? %>"
                  title="<%= t("paths.#{path.status}") %>"><%= path.title %><span class="for-screen-reader"> — <%= t("paths.#{path.status}") %></span></span>
          <% end %>
        </p>
      <% end %>
      <p class="catalog-soon__actions">
        <a href="<%= new_feedback_path(about: "profession", from: paths_path) %>" class="catalog-soon__cta"><%= t("paths.soon_idea") %></a>
        <span aria-hidden="true">·</span>
        <a href="<%= contribute_path %>" class="catalog-soon__cta"><%= t("paths.soon_curator") %></a>
      </p>
    </div>
  </div>
</section>
