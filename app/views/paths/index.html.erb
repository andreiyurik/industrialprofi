<% canonical_url(root_url) %>

<% content_for(:head) do %>
  <%= json_ld_tag(website_json_ld) %>
  <%= json_ld_tag(organization_json_ld) %>
<% end %>

<section class="hero">
  <div class="container hero__inner">
    <h1 class="hero__title is-caret"><%= t("paths.hero.title_html") %></h1>
    <p class="hero__subtitle"><%= t("paths.hero.subtitle_html") %></p>
  </div>
</section>

<section class="section home-catalog">
  <div class="container">
    <% if @focus_path %>
      <div class="panel focus-banner">
        <span class="focus-banner__text">
          <%= t("paths.focus_banner_html", title: link_to(@focus_path.title, path_path(@focus_path), class: "focus-banner__link")) %>
        </span>
        <% if @focus_next_lesson %>
          <%= link_to @focus_next_lesson, class: "btn btn--small btn--reversed" do %>
            <%= t("dashboard.continue") %>
            <%= icon_tag "arrow-right" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @paths.any? %>
      <div class="catalog-grid" id="catalog">
        <% @paths.each do |path| %>
          <%= render "path_card", path: path,
                completed_count: @completed_counts.fetch(path.id, 0),
                courses_count: @course_counts.fetch(path.id, 0) %>
        <% end %>
      </div>
    <% else %>
      <%# A language with no maps yet (English today): say so plainly and hand
          the reader the catalog that exists, instead of an empty page they
          can't explain. %>
      <div class="panel catalog-empty" id="catalog">
        <p class="catalog-empty__text"><%= t("paths.empty_locale_html") %></p>
        <%= link_to t("paths.empty_locale_cta"), root_path(locale: I18n.default_locale), class: "btn btn--reversed", lang: I18n.default_locale, hreflang: I18n.default_locale %>
      </div>
    <% end %>

    <%# Not a roadmap — an open invitation. Everything the hero already says is
        left out on purpose: what survives is the one thing said nowhere else on
        this page — the names of the vacant professions. Heading, list, one link. %>
    <div class="catalog-soon">
      <h2 class="catalog-soon__label"><%= t("paths.group_upcoming") %></h2>
      <p class="catalog-soon__list">
        <% t("paths.soon_wanted").each do |title| %>
          <span class="catalog-soon__slot"><%= title %></span>
        <% end %>
        <%# Last in the same wrapping row, so the list ends where it ends instead of
            handing off to a stray line below it. %>
        <%= link_to contribute_path(anchor: "wanted"), class: "catalog-soon__more link-quiet" do %>
          <%= t("paths.soon_full_list") %>
          <%= icon_tag "arrow-right" %>
        <% end %>
      </p>
      <p class="catalog-soon__call">
        <%= link_to contribute_path, class: "btn",
              data: { controller: "rough-annotation",
                      rough_annotation_type_value: "circle",
                      rough_annotation_stroke_width_value: "2",
                      rough_annotation_padding_value: "10" } do %>
          <%= t("paths.soon_curator") %>
          <%= icon_tag "arrow-right" %>
        <% end %>
      </p>
    </div>
  </div>
</section>
