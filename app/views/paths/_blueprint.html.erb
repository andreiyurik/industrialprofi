<%# locals: (callouts:, revisions:) -%>
<%# The same parts are laid out twice — a portrait sheet for phones, a landscape one from 64em.
    Without JS the installation runs by itself; the plant controller switches it off and hands it over. %>
<% scope = "paths.blueprint" %>
<% lessons = callouts.transform_values { |path| path_path(path) } %>
<figure class="blueprint scene--art" data-controller="plant"
        data-plant-messages-value="<%= t("paths.plant.messages").to_json %>"
        data-plant-share-value="<%= t("paths.plant.share_text") %>" data-plant-url-value="<%= root_url %>"
        data-plant-shared-value="<%= t("paths.plant.shared") %>">
  <svg class="blueprint__art blueprint__art--tall" viewBox="0 0 360 470" role="group" aria-label="<%= t("alt", scope: scope) %>">
    <%= render "paths/blueprint/paper", id: "bp-tall", width: 360, height: 470 %>
    <%= render "paths/blueprint/callouts", callouts: callouts, power: 88, control: 272, y: 29 %>
    <g style="--d: 0.5s">
      <path class="art-wire bp-cable bp-cable--drive bp-draw" pathLength="1" d="M132 228V256H170V276" />
      <path class="art-wire bp-cable bp-cable--control bp-draw" pathLength="1" d="M160 200H200" />
      <path class="art-wire bp-cable bp-cable--command bp-draw" pathLength="1" d="M244 228V256H190V276" />
      <path class="art-wire art-wire--dashed bp-fade" d="M300 228V287" />
      <path class="art-dots bp-dots bp-dots--drive" d="M132 228V256H170V276" />
      <path class="art-dots bp-dots bp-dots--control" d="M160 200H200" />
      <path class="art-dots bp-dots bp-dots--run" d="M244 228V256H190V276" />
      <path class="art-dots bp-dots bp-dots--run" d="M300 287V228" />
      <text class="bp-tag bp-fade" style="--d: 0.9s" x="138" y="247.5"><%= t("volts", scope: scope) %></text>
      <text class="bp-tag bp-fade" style="--d: 0.9s" x="307" y="262"><%= t("signal", scope: scope) %></text>
    </g>
    <%= render "paths/blueprint/power", tall: true %>
    <%= render "paths/blueprint/control", tall: true %>
    <g style="--d: 0.4s">
      <path class="art-ink bp-paper bp-draw" pathLength="1" d="M22 328H118V348H22M338 328H242V348H338" />
      <path class="art-quiet bp-fade" d="M22 325q4 6.5 0 13q-4 6.5 0 13M338 325q4 6.5 0 13q-4 6.5 0 13" />
      <path class="art-dots bp-dots bp-dots--run bp-dots--water" d="M26 338H118M242 338H334" />
    </g>
    <%= render "paths/blueprint/valve" %>
    <g class="bp-fade" style="--d: 0.9s"><path class="bp-dim" d="M96 348 88 376H52" /><text class="bp-tag" x="54" y="372.5">DN 50</text></g>
    <%= render "paths/blueprint/meter" %>
    <%= render "paths/blueprint/unit", id: "bp-tall" %>
    <g class="bp-fade" style="--d: 0.8s">
      <path class="art-quiet" d="M24 427H120M240 427H336" />
      <path class="art-far" d="<%= ((30..114).step(12).to_a + (252..330).step(12).to_a).map { |x| "M#{x} 427l-6 7" }.join %>" />
    </g>
  </svg>

  <svg class="blueprint__art blueprint__art--wide" viewBox="0 0 880 460" role="group" aria-label="<%= t("alt", scope: scope) %>">
    <%= render "paths/blueprint/paper", id: "bp-wide", width: 880, height: 460 %>
    <%= render "paths/blueprint/callouts", callouts: callouts, power: 132, control: 748, y: 27 %>
    <g style="--d: 0.5s">
      <path class="art-wire bp-cable bp-cable--drive bp-draw" pathLength="1" d="M204 196H230V100H424V171" />
      <path class="art-wire bp-cable bp-cable--control bp-draw" pathLength="1" d="M204 186H216V80H664V130H676" />
      <path class="art-wire bp-cable bp-cable--command bp-draw" pathLength="1" d="M676 150H456V171" />
      <path class="art-wire art-wire--dashed bp-fade" d="M608 188V170H676" />
      <path class="art-dots bp-dots bp-dots--drive" d="M204 196H230V100H424V171" />
      <path class="art-dots bp-dots bp-dots--control" d="M204 186H216V80H664V130H676" />
      <path class="art-dots bp-dots bp-dots--run" d="M676 150H456V171" />
      <path class="art-dots bp-dots bp-dots--run" d="M608 188V170H676" />
      <text class="bp-tag bp-fade" style="--d: 0.9s" x="327" y="115" text-anchor="middle"><%= t("volts", scope: scope) %></text>
      <text class="bp-tag bp-fade" style="--d: 0.9s" x="648" y="186" text-anchor="middle"><%= t("signal", scope: scope) %></text>
    </g>
    <g transform="translate(44 -4)"><%= render "paths/blueprint/power", tall: false %></g>
    <g transform="translate(476 -4)"><%= render "paths/blueprint/control", tall: false %></g>
    <g style="--d: 0.4s">
      <path class="art-ink bp-paper bp-draw" pathLength="1" d="M22 254H341V286H22M858 254H539V286H858" />
      <path class="art-quiet bp-fade" d="M22 251q4 9.5 0 19q-4 9.5 0 19M858 251q4 9.5 0 19q-4 9.5 0 19" />
      <path class="art-dots bp-dots bp-dots--run bp-dots--water" d="M28 270H341M539 270H852" />
      <g class="bp-fade" style="--d: 0.9s"><path class="bp-dim" d="M176 286 184 304H216" /><text class="bp-tag" x="186" y="300.5">DN 50</text></g>
      <% [ 132, 748 ].each do |x| %>
        <g class="bp-fade" style="--d: 0.8s">
          <path class="art-ink art-body" d="M<%= x - 5 %> 290h10v116h-10zM<%= x - 14 %> 406h28v6h-28z" />
          <path class="art-ink" d="M<%= x - 20 %> 290h40M<%= x - 20 %> 290v-8M<%= x + 20 %> 290v-8" />
        </g>
      <% end %>
    </g>
    <%# The pump and its fittings are the subject: drawn 1.6× on the wide sheet. %>
    <g class="bp-big" transform="translate(272 270) scale(1.6) translate(-64 -338)"><%= render "paths/blueprint/valve" %></g>
    <g class="bp-big" transform="translate(608 270) scale(1.6) translate(-300 -338)"><%= render "paths/blueprint/meter" %></g>
    <g class="bp-big" transform="translate(440 270) scale(1.6) translate(-180 -338)"><%= render "paths/blueprint/unit", id: "bp-wide" %></g>
    <g class="bp-fade" style="--d: 0.8s">
      <path class="art-quiet" d="M24 412H344M536 412H856" />
      <path class="art-far" d="<%= ((30..336).step(12).to_a + (548..680).step(12).to_a).map { |x| "M#{x} 412l-6 7" }.join %>" />
      <%# The title block: who drew it, who checked it, and the vacancy. %>
      <g class="bp-stamp">
        <path class="art-quiet bp-paper" d="M545.5 425.5h328v28h-328zM545.5 439.5h328M587.5 425.5v14M645.5 425.5v14M677.5 425.5v14M725.5 425.5v14M775.5 425.5v14M633.5 439.5v14M691.5 439.5v14M737.5 439.5v14M783.5 439.5v14" />
        <text class="bp-tag" x="550" y="436"><%= t("stamp_drawn", scope: scope) %></text>
        <text class="bp-label" x="592" y="436"><%= t("stamp_drawn_by", scope: scope) %></text>
        <text class="bp-tag" x="650" y="436"><%= t("stamp_checked", scope: scope) %></text>
        <text class="bp-label" x="682" y="436"><%= t("stamp_checked_by", scope: scope) %></text>
        <text class="bp-tag" x="730" y="436"><%= t("stamp_norm", scope: scope) %></text>
        <%= link_to contribute_path, class: "bp-stamp__link" do %>
          <rect class="bp-target" x="775.5" y="425.5" width="98" height="14"></rect>
          <text x="780" y="436"><%= t("stamp_norm_by", scope: scope) %> →</text>
        <% end %>
        <text class="bp-label" x="550" y="450"><%= t("stamp_title", scope: scope) %></text>
        <%= link_to changes_path, class: "bp-stamp__link" do %>
          <rect class="bp-target" x="633.5" y="439.5" width="58" height="14"></rect>
          <text x="638" y="450"><%= t("stamp_changes", scope: scope, count: revisions) %> →</text>
        <% end %>
        <text class="bp-label" x="696" y="450"><%= t("stamp_price", scope: scope) %></text>
        <text class="bp-tag" x="742" y="450"><%= t("stamp_sheets", scope: scope) %></text>
        <text class="bp-tag" x="788" y="450"><%= t("stamp_scale", scope: scope) %></text>
      </g>
    </g>
  </svg>

  <div class="plant">
    <p class="plant__status" aria-live="polite">
      <span class="plant__step" data-plant-target="step" hidden></span>
      <span data-plant-target="status"><%= t("paths.plant.running") %></span>
      <% lessons.each do |slot, href| %>
        <%= link_to href, class: "plant__lesson", hidden: true, data: { plant_target: "lesson", slot: slot } do %><%= t("paths.plant.lesson", title: callouts[slot].title) %><%= icon_tag "arrow-right" %><% end %>
      <% end %>
    </p>
    <p class="plant__done" data-plant-target="done" hidden>
      <%= link_to t("paths.plant.learn"), "#catalog", class: "plant__act" %>
      <button type="button" class="plant__act" data-action="plant#share" data-plant-target="share"><%= t("paths.plant.share") %></button>
      <button type="button" class="plant__act" data-action="plant#reset"><%= t("paths.plant.again") %></button>
    </p>
  </div>
</figure>
