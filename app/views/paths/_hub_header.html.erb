<%# locals: (path:, progress:, tab:) -%>
<%# The overview carries the full pitch; the other tabs keep one title row so their content starts on the first screen. %>
<% overview = tab == :overview %>
<% inventory = path.inventory %>
<header class="hub<%= " hub--compact" unless overview %>">
  <%# view-transition-name pairs with the catalog card in paths/_path_card. %>
  <div class="hub__identity" style="view-transition-name: path-<%= path.slug %>">
    <% ring = overview && progress.started? && path.lessons_count.positive? %>
    <div class="topic-hero-icon<%= " topic-hero-icon--ring" if ring %>">
      <% if ring %>
        <%= render layout: "shared/progress_ring", locals: { completed: progress.completed_count, total: path.lessons_count } do %>
          <%= render "shared/topic_badge", token: path.emblem %>
        <% end %>
      <% else %>
        <%= render "shared/topic_badge", token: path.emblem %>
      <% end %>
    </div>
    <h1 class="path__title"><%= link_to_unless overview, path.title, path_path(path), class: "hub__home" %></h1>
    <% if overview %>
      <p class="hub__description"><%= path.description %></p>
    <% end %>
  </div>

  <%# On every tab: trust before the reader commits, and the way in to improving the map. %>
  <%= render "paths/maturity", path: path, curators: path.curators.to_a %>

  <% if overview %>
    <%= render "shared/continue_cta", continue_lesson: progress.next_lesson, completed_ids: progress.completed_ids %>
    <ul class="hub-stats" role="list">
      <%= hub_stat t("common.course", count: inventory.chapters) %>
      <%= hub_stat t("courses.lessons_count", count: inventory.lessons) %>
      <%= hub_stat t("projects.tasks", count: inventory.tasks) if inventory.tasks.positive? %>
    </ul>
  <% end %>

  <%= render "paths/unlisted_notice", path: path %>
</header>

<nav class="hub-tabs" aria-label="<%= t("paths.hub.tabs_label") %>">
  <%= hub_tab t("paths.overview"), path_path(path), icon: "info", current: overview %>
  <%= hub_tab t("paths.hub.theory"), path_theory_path(path), icon: "graduation-cap", current: tab == :theory, count: inventory.lessons %>
  <%= hub_tab t("paths.hub.practice"), path_practice_path(path), icon: "wrench", current: tab == :practice, count: inventory.tasks %>
  <%= hub_tab t("paths.hub.library"), path_library_path(path), icon: "book-open", current: tab == :library, count: inventory.documents + inventory.calculators %>
  <% if path.has_glossary? %>
    <%= hub_tab t("paths.hub.glossary"), path_glossary_path(path), icon: "text-aa", current: tab == :glossary, count: inventory.terms %>
  <% end %>
</nav>
