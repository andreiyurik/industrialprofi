<%# locals: (path:, index: nil, completed_count: 0, courses_count: nil) -%>
<% courses_count ||= path.courses_count %>
<a href="<%= path_path(path) %>" class="panel panel--hover path-card">
  <% if index %><span class="path-card__index" aria-hidden="true"><%= format("%02d", index) %></span><% end %>
  <h2 class="path-card__title"><%= path.title %></h2>
  <div class="path-card__foot">
    <div class="path-card__meta-row">
      <span class="path-card__meta">
        <% if courses_count.positive? %><%= russian_pluralize(courses_count, :course) %> · <% end %><%= russian_pluralize(path.lessons_count, :lesson) %>
      </span>
      <span class="path-card__go" aria-hidden="true">→</span>
    </div>
    <% if completed_count.positive? %>
      <%= render "shared/progress_bar", completed: completed_count, total: path.lessons_count %>
    <% end %>
  </div>
</a>
