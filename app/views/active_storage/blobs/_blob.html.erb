<figure class="attachment attachment--<%= blob.representable? ? "preview" : "file" %> attachment--<%= blob.filename.extension %>">
  <% if blob.image? %>
    <%# Intrinsic width/height prevent layout shift while loading (Core Web Vitals / CLS); absent until ActiveStorage analyses the upload. %>
    <% img_opts = { alt: blob.try(:caption).presence || blob.filename.base, loading: "lazy" }
       if (w = blob.metadata["width"]) && (h = blob.metadata["height"])
         img_opts.merge!(width: w, height: h)
       end %>
    <% if ApplicationHelper.variant_processing_available? %>
      <%# Resized, re-encoded WebP — light and SEO-friendly; the full upload stays archived. %>
      <%= image_tag blob.representation(
            resize_to_limit: local_assigns[:in_gallery] ? [ 800, 600 ] : [ 1600, 1200 ],
            format: :webp, saver: { quality: 80 }), **img_opts %>
    <% else %>
      <%# No image processor here — serve the original so it still shows instead of a broken variant URL. %>
      <%= image_tag rails_blob_path(blob), **img_opts %>
    <% end %>
  <% end %>

  <figcaption class="attachment__caption">
    <% if caption = blob.try(:caption) %>
      <%= caption %>
    <% else %>
      <span class="attachment__name"><%= blob.filename %></span>
      <span class="attachment__size"><%= number_to_human_size blob.byte_size %></span>
    <% end %>
  </figcaption>
</figure>
