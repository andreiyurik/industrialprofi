<% meta_title(t("glossary.title")) %>
<% meta_description(t("glossary.description")) %>
<% canonical_url(glossary_url) %>

<% content_for(:head) do %>
  <%= json_ld_tag(breadcrumb_json_ld([
    { title: t("breadcrumbs.home"), url: "#{site_config.url}/" },
    { title: t("glossary.title"), url: "#{site_config.url}/glossary" }
  ])) %>
  <%= json_ld_tag(glossary_json_ld(@groups)) %>
<% end %>

<section class="section">
  <div class="container container--reading" data-controller="glossary-filter">
    <div class="txt-align-center">
      <h1 class="section-title"><%= t("glossary.title") %></h1>
      <p class="section-subtitle"><%= t("glossary.intro") %></p>
    </div>

    <%# Filter is pure client-side DOM (glossary_filter_controller) — the page
        is one server render however long the list grows; the VPS never hears
        a keystroke. No-JS readers still have anchors and Ctrl+F. %>
    <div class="glossary-toolbar">
      <input type="search" class="input glossary-toolbar__input"
             placeholder="<%= t("glossary.filter_placeholder") %>"
             aria-label="<%= t("glossary.filter_placeholder") %>"
             data-action="input->glossary-filter#filter">
      <div class="glossary-scripts" role="group" aria-label="<%= t("glossary.scripts_label") %>">
        <% { "all" => t("glossary.script_all"), "ru" => t("glossary.script_ru"), "int" => t("glossary.script_int") }.each do |script, label| %>
          <button type="button" aria-pressed="<%= script == "all" %>"
                  data-glossary-filter-target="scriptTab"
                  data-action="glossary-filter#setScript"
                  data-glossary-filter-script-param="<%= script %>"><%= label %></button>
        <% end %>
      </div>
      <%# Profession chips lead into each profession's own dictionary (its hub
          «Словарь» tab) — «выбрал профессию — видишь только её» is one click,
          and this full page keeps its SEO weight. %>
      <% if @groups.many? %>
        <nav class="glossary-chips" aria-label="<%= t("glossary.chips_label") %>">
          <% @groups.each do |path, terms| %>
            <a href="<%= path_glossary_path(path) %>" class="glossary-chip">
              <%= path.title %> <span class="glossary-chip__count"><%= terms.size %></span>
            </a>
          <% end %>
        </nav>
      <% end %>
    </div>

    <% @groups.each do |path, terms| %>
      <%= render "glossaries/group", path: path, terms: terms %>
    <% end %>

    <p class="glossary-empty" hidden data-glossary-filter-target="empty">
      <%= t("glossary.empty") %>
      <a href="<%= search_path %>" data-glossary-filter-target="searchLink"><%= t("glossary.search_lessons") %></a>
    </p>

    <p class="glossary-feedback">
      <%= t("glossary.feedback") %>
      <% if signed_in? %>
        <%= link_to t("glossary.feedback_link"), new_feedback_path %>
      <% else %>
        <a href="<%= site_config.telegram_url %>" target="_blank" rel="noopener"><%= t("glossary.feedback_link") %></a>
      <% end %>
    </p>
  </div>
</section>
