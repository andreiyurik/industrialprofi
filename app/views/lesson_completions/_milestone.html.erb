<%# The loud cheer — reserved for finishing the whole profession, the one
    moment a learner has something genuinely worth showing. Rendered into the
    :flash frame, so the next flash update simply replaces it. %>
<% path_url = "#{site_config.url}/paths/#{path.slug}" %>
<% practice_count = path.lessons.practice.count %>
<% tg_share = "https://t.me/share/url?#{ { url: path_url, text: t(".share_text", title: path.title) }.to_query }" %>

<div data-controller="dialog">
  <dialog class="milestone" data-dialog-target="dialog" data-action="click->dialog#backdropClose">
    <button type="button" class="milestone__close" data-action="dialog#close"
            aria-label="<%= t("common.close") %>">
      <%= heroicon "x-mark", variant: :outline %>
    </button>

    <span class="milestone__emblem" aria-hidden="true"><%= heroicon "academic-cap", variant: :outline %></span>

    <p class="milestone__eyebrow"><%= t(".eyebrow") %></p>
    <h2 class="milestone__title"><%= path.title %></h2>

    <p class="milestone__stats">
      <%= t("common.lesson", count: path.lessons_count) %><% if practice_count.positive? %> · <%= t(".practice", count: practice_count) %><% end %>
    </p>

    <p class="milestone__note"><%= t(".note") %></p>

    <div class="milestone__actions">
      <a href="<%= tg_share %>" class="btn btn--reversed" target="_blank" rel="noopener"><%= t(".share_telegram") %></a>
      <%= link_to t(".next_path"), paths_path, class: "btn" %>
    </div>
  </dialog>
</div>
