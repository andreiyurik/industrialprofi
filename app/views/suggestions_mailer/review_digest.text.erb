<%= t("suggestions_mailer.review_digest.greeting", name: @user.name) %>

<%= t("suggestions_mailer.review_digest.body", count: @pending.size) %>

<% @pending.each do |suggestion| %>
- «<%= suggestion.lesson.title %>» — <%= suggestion.author_name %>, <%= l(suggestion.created_at.to_date) %>
<% end %>

<%= t("suggestions_mailer.review_digest.cta") %>: <%= admin_lesson_suggestions_url %>

<%= t("suggestions_mailer.review_digest.once") %>

<%= t("suggestions_mailer.review_digest.unsubscribe") %>: <%= @unsubscribe_url %>
