<%= t("suggestions_mailer.outcome.greeting", name: @user.name) %>

<%= t("suggestions_mailer.outcome.body_#{@suggestion.status}", lesson: @lesson.title) %>
<% if @suggestion.approved? && @suggestion.raised_path_stage %>

<%= t("suggestions_mailer.outcome.raised_stage", path: @lesson.path.title, stage: @suggestion.raised_path_stage, total: Path::Maturity::MATURITY_STAGES) %>
<% end %>
<% if @suggestion.rejected? && @suggestion.reviewer_comment.present? %>

<%= t("suggestions_mailer.outcome.comment_label") %>
<%= @suggestion.reviewer_comment %>
<% end %>

<% if @suggestion.approved? %>
<%= t("suggestions_mailer.outcome.view_history") %>: <%= lesson_revisions_url(@lesson) %>
<% else %>
<%= t("suggestions_mailer.outcome.view_lesson") %>: <%= lesson_url(@lesson) %>
<% end %>

<%= t("suggestions_mailer.outcome.thanks") %>

<%= t("suggestions_mailer.outcome.unsubscribe") %>: <%= @unsubscribe_url %>
