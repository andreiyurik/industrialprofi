<% content_for :mailer_footer do %>
  <p style="<%= mail_style(:muted) %>"><%= mail_link_to t("suggestions_mailer.review_digest.unsubscribe"), @unsubscribe_url %></p>
<% end %>

<h1 style="<%= mail_style(:title) %>"><%= t("suggestions_mailer.review_digest.greeting", name: @user.name) %></h1>

<p style="<%= mail_style(:subtitle) %>"><%= t("suggestions_mailer.review_digest.body", count: @pending.size) %></p>

<ul style="<%= mail_style(:list) %>">
  <% @pending.each do |suggestion| %>
    <li style="<%= mail_style(:list_item) %>">
      «<%= suggestion.lesson.title %>» — <%= suggestion.author_name %>,
      <%= l(suggestion.created_at.to_date) %>
    </li>
  <% end %>
</ul>

<%= render "shared/mailer/button", text: t("suggestions_mailer.review_digest.cta"), url: admin_lesson_suggestions_url %>

<p style="<%= mail_style(:muted) %>"><%= t("suggestions_mailer.review_digest.once") %></p>
