<% meta_title(t("account.title")) %>

<%# Fizzy users/edit anatomy, verbatim: ONE bordered panel card (~45ch), the
    avatar block on top, large rounded fields (no per-field labels — values and
    placeholders speak), the email value carries its change-link INSIDE the
    field row, and a single full-width primary save. Password/danger sit under
    a hairline at the card's foot — flows Fizzy keeps on separate pages, kept
    here because this is our only account surface. %>
<section class="section">
  <div class="container">
    <h1 class="section-title"><%= t("account.title") %></h1>

    <div class="panel account-card">
      <div class="account-card__identity">
        <span class="account-card__portrait"><%= avatar_tag(Current.user) %></span>

        <%# Preset picker (no uploads — see Avatar): radio grid on the admin
            emblem-field mechanic, auto-submit saves the click. %>
        <details class="avatar-picker">
          <summary class="avatar-picker__summary"><%= t("account.avatar_change") %></summary>
          <%= form_with url: account_path, method: :patch,
                data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |f| %>
            <div class="avatar-picker__grid">
              <label class="avatar-picker__option" title="<%= t("account.avatar_default") %>">
                <%= radio_button_tag "user[avatar_token]", "", Current.user.avatar_token.blank?,
                      aria: { label: t("account.avatar_default") } %>
                <span class="avatar" style="--avatar-hue: var(<%= avatar_hue_token(Current.user.name) %>)" aria-hidden="true"><%= avatar_initials(Current.user.name) %></span>
              </label>
              <% Avatar::PRESETS.each do |token, preset| %>
                <label class="avatar-picker__option" title="<%= t("account.avatars.#{token}") %>">
                  <%= radio_button_tag "user[avatar_token]", token, Current.user.avatar_token == token,
                        aria: { label: t("account.avatars.#{token}") } %>
                  <span class="avatar avatar--glyph" style="--avatar-hue: var(<%= preset[:hue] %>)" aria-hidden="true"><%= icon_tag preset[:icon] %></span>
                </label>
              <% end %>
            </div>
            <noscript><%= f.submit t("account.save"), class: "btn btn--small" %></noscript>
          <% end %>
        </details>

        <% if Current.user.photo_allowed? %>
          <%# A curator may show a face (members keep the disc — bounded by
              grants, not users). Picking a file uploads it at once; one 256px
              WebP is stored, the original is never kept (User::Photo). %>
          <div class="photo-actions">
            <%= form_with url: account_photo_path, method: :post, multipart: true,
                  data: { controller: "auto-submit" } do |f| %>
              <label class="photo-actions__upload link-quiet">
                <%= f.file_field :photo, accept: LessonImageUpload.accept_attribute, class: "for-screen-reader",
                      data: { action: "change->auto-submit#submit" } %>
                <%= t(Current.user.photo.attached? ? "account.photo_change" : "account.photo_upload") %>
              </label>
              <noscript><%= f.submit t("account.save"), class: "btn btn--small" %></noscript>
            <% end %>
            <% if Current.user.photo.attached? %>
              <%= button_to t("account.photo_remove"), account_photo_path, method: :delete,
                    class: "photo-actions__remove link-quiet" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# One form, one save — Fizzy's shape. The readonly email row lives
          inside it visually; without a name attribute it never submits. %>
      <%= form_with url: account_path, method: :patch, class: "account-card__form" do |f| %>
        <%= f.text_field :name, value: Current.user.name, name: "user[name]",
              required: true, autocomplete: "name", class: "input",
              placeholder: t("account.name_label"), aria: { label: t("account.name_label") } %>

        <div class="input account-card__actor">
          <span class="account-card__actor-value"><%= Current.user.email_address %></span>
          <%= link_to t("account.change_email"), edit_account_email_path, class: "account-card__actor-link" %>
        </div>

        <label class="account-card__checkbox">
          <%= hidden_field_tag "user[reminder_emails]", "0", id: nil %>
          <%= check_box_tag "user[reminder_emails]", "1", Current.user.reminder_emails? %>
          <span>
            <%= t("account.reminder_emails_label") %>
            <span class="account-card__hint"><%= t("account.reminder_emails_hint") %></span>
          </span>
        </label>
        <label class="account-card__checkbox">
          <%= hidden_field_tag "user[suggestion_emails]", "0", id: nil %>
          <%= check_box_tag "user[suggestion_emails]", "1", Current.user.suggestion_emails? %>
          <span>
            <%= t("account.suggestion_emails_label") %>
            <span class="account-card__hint"><%= t("account.suggestion_emails_hint") %></span>
          </span>
        </label>

        <% if Current.user.can_edit_content? %>
          <%= f.text_field :headline, value: Current.user.headline, name: "user[headline]",
                maxlength: 120, placeholder: t("account.headline_placeholder"), class: "input",
                aria: { label: t("account.headline_label") } %>
          <span class="account-card__hint"><%= t("account.headline_hint") %></span>
        <% end %>

        <% if @name_errors.any? %>
          <p class="account-card__error" role="alert"><%= @name_errors.first %></p>
        <% end %>

        <%= f.submit t("account.save"), class: "btn btn--reversed account-card__save" %>
      <% end %>

      <%# Пароль — свёрнут: нужен редко, а три поля громкие %>
      <div class="account-card__foot">
        <% if @password_errors.any? %>
          <p class="account-card__error" role="alert"><%= @password_errors.first %></p>
        <% end %>
        <details class="account-card__disclosure"<%= " open" if @password_errors.any? %>>
          <summary><%= t("account.change_password") %></summary>
          <%= form_with url: account_password_path, method: :patch, class: "account-card__form" do |f| %>
            <%= f.password_field :current_password, required: true,
                  autocomplete: "current-password", class: "input",
                  placeholder: t("account.current_password"), aria: { label: t("account.current_password") } %>
            <%= tag.input type: "password", name: "user[password]", required: true,
                  minlength: 8, autocomplete: "new-password", class: "input",
                  placeholder: t("account.new_password"), aria: { label: t("account.new_password") } %>
            <%= tag.input type: "password", name: "user[password_confirmation]", required: true,
                  minlength: 8, autocomplete: "new-password", class: "input",
                  placeholder: t("auth.password_confirmation"), aria: { label: t("auth.password_confirmation") } %>
            <%= f.submit t("account.save_password"), class: "btn btn--reversed account-card__save" %>
          <% end %>
        </details>

        <details class="account-card__disclosure account-card__disclosure--danger">
          <summary><%= t("account.danger_zone") %></summary>
          <p class="account-card__hint"><%= t("account.delete_warning") %></p>
          <div>
            <%= link_to new_account_deletion_path, class: "btn btn--small account-card__danger-btn" do %>
              <%= icon_tag "trash" %>
              <%= t("account.delete_account") %>
            <% end %>
          </div>
        </details>
      </div>
    </div>
  </div>
</section>
