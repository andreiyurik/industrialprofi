<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <%# Chrome pages exist in every locale; content URLs carry the locale their
      Path lives in. Data hubs whose EN side is still empty (projects,
      resources, glossary) stay RU-only until content exists — an empty page
      in the sitemap reads as thin content, not as ambition. %>
  <% I18n.available_locales.each do |locale| %>
  <% base = "#{site_config.url}/#{locale}" %>
  <url>
    <loc><%= base %></loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc><%= base %>/paths</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc><%= base %>/calculators</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <% Calculator.all.each do |calculator| %>
  <url>
    <loc><%= base %>/calculators/<%= calculator.slug %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>
  <url>
    <loc><%= base %>/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc><%= base %>/roadmap</loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
  <url>
    <loc><%= base %>/faq</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc><%= base %>/guide</loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
  <url>
    <loc><%= base %>/support_us</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc><%= base %>/business</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc><%= base %>/authors</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <% end %>
  <% ru = "#{site_config.url}/ru" %>
  <url>
    <loc><%= ru %>/projects</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc><%= ru %>/resources</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <% @paths.each do |path| %>
  <url>
    <loc><%= site_config.url %>/<%= path.locale %>/resources?path=<%= path.slug %></loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>
  <url>
    <loc><%= ru %>/glossary</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <% @paths.select { |path| Glossary.path_slugs.include?(path.slug) }.each do |path| %>
  <url>
    <loc><%= ru %>/glossary?path=<%= path.slug %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>
  <% @paths.each do |path| %>
  <url>
    <loc><%= site_config.url %>/<%= path.locale %>/paths/<%= path.slug %></loc>
    <lastmod><%= path.updated_at.strftime("%Y-%m-%d") %></lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <% end %>
  <% @courses.each do |course| %>
  <url>
    <loc><%= site_config.url %>/<%= course.path.locale %>/courses/<%= course.slug %></loc>
    <lastmod><%= course.updated_at.strftime("%Y-%m-%d") %></lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <% end %>
  <% @lessons.each do |lesson| %>
  <url>
    <loc><%= site_config.url %>/<%= lesson.path.locale %>/lessons/<%= lesson.slug %></loc>
    <lastmod><%= lesson.updated_at.strftime("%Y-%m-%d") %></lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <% end %>
</urlset>
