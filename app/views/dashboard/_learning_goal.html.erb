<%= turbo_frame_tag "learning_goal" do %>
  <% if Current.user.learning_goal.present? %>
    <p class="learning-goal">
      <span class="learning-goal__text">«<%= Current.user.learning_goal %>»</span>
      <%= link_to t("dashboard.goal.edit"), edit_learning_goal_path, class: "learning-goal__edit link-quiet link-quiet--underline" %>
    </p>
  <% else %>
    <p class="learning-goal">
      <%= link_to t("dashboard.goal.prompt"), edit_learning_goal_path, class: "link-quiet link-quiet--underline" %>
    </p>
  <% end %>
<% end %>
