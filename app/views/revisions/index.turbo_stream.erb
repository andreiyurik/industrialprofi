<%= turbo_stream.append "revisions_list" do %>
  <%= render "revisions/history_rows", revisions: @revisions, boundary_date: @boundary_date %>
<% end %>

<%= turbo_stream.replace "revisions_more" do %>
  <%= render "revisions/more", lesson: @lesson, more: @more,
        next_cursor: @next_cursor, boundary_date: @revisions.last&.created_at&.to_date %>
<% end %>
