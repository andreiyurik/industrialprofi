<h1 style="<%= mail_style(:title) %>"><%= t("passwords_mailer.reset.greeting", name: @user.name) %></h1>

<p style="<%= mail_style(:subtitle) %>"><%= t("passwords_mailer.reset.body") %></p>

<%= render "shared/mailer/button", text: t("passwords_mailer.reset.link_text"), url: edit_password_url(@user.password_reset_token) %>

<p style="<%= mail_style(:muted) %>"><%= t("passwords_mailer.reset.expires") %></p>

<p style="<%= mail_style(:muted) %>"><%= t("passwords_mailer.reset.ignore") %></p>
