<% meta_title(t("guide.title")) %>
<% meta_description(t("guide.intro").truncate(160)) %>
<% canonical_url("#{site_config.url}/guide") %>

<%# The public author's reference — open like the content itself (CC BY-SA):
    readers suggesting an edit and editors reviewing one read the SAME rules.
    The badges and callouts below are rendered with the SAME helpers production
    uses, so this page can never drift. Prose is inline (a static Russian doc),
    labels come from the shared i18n. %>
<% type_notes = {
     "norm"     => "Официальный обязательный документ: ГОСТ, ПУЭ, ПТЭЭП, СП, СНиП, НАКС, РД, приказы, а также международные IEC / ISO / ASME / EN / DIN. Спина контента — где тема регулируется, ссылаемся на первоисточник, а не на пересказ.",
     "book"     => "Учебник, справочник, руководство — систематическое изложение темы (справочник электрика, учебник по сварке). Когда нужна глубина и контекст, а не одна норма.",
     "doc"      => "Документация производителя: даташит, техпаспорт, руководство по эксплуатации, каталог. Привязана к конкретному изделию — особенно важно для КИПиА (датчик, ПЛК, реле). Это паспорт прибора, а не норматив и не учебник.",
     "course"   => "Структурированная программа обучения: онлайн-курс, ДПО, учебный центр, видеокурс. Целая программа, а не один материал; часто платная.",
     "video"    => "Видеоразбор или демонстрация — YouTube, запись вебинара. Когда показать важнее, чем описать: монтаж, приёмы, работа прибором.",
     "article"  => "Статья, разбор, объяснение — habr-стиль, экспертный блог. Хорошо объясняет тему простым языком, дополняя норматив.",
     "software" => "Программа или веб-сервис, которым работают: Modbus Poll, UaExpert, Wireshark, онлайн-калькулятор, конфигуратор. То, что запускают, а не читают.",
     "tool"     => "Физический инструмент или материал для практики — ссылка, где приобрести (мультиметр, указатель напряжения, набор для пайки). Для практических заданий: «что понадобится и где взять»."
   } %>
<% callout_notes = {
     "ОПАСНО"  => { sample: "Работы под напряжением без снятия и проверки отсутствия напряжения недопустимы.",
                    when: "Угроза жизни, здоровью или оборудованию: напряжение, давление, высота, газ. Только по делу — иначе блок перестают замечать." },
     "ВАЖНО"   => { sample: "Группа III «до 1000 В» не даёт права работать в установках 6–10 кВ.",
                    when: "Ключевой факт, который легко упустить и дорого ошибиться, но это не прямая угроза жизни." },
     "СОВЕТ"   => { sample: "Для опрессовки наконечников удобнее гидравлический пресс, а не ручные клещи.",
                    when: "Практическая рекомендация, лайфхак, какой инструмент удобнее. Необязательное, но полезное." },
     "ПРИМЕР"  => { sample: "Ток нагрузки 25 А → сечение по таблице ПУЭ → автомат 25 А, кабель 4 мм².",
                    when: "Разобранный пример или расчёт, пошагово и с числами — показать применение нормы на конкретике." },
     "ПРОВЕРЬ" => { sample: "В каких установках действует ваша группа допуска и почему это указано в удостоверении?",
                    when: "Блок самопроверки в конце теории: вопросы со ссылкой на норматив, заставляющие думать, а не вспоминать." }
   } %>

<section class="section">
  <div class="container container--reading">
    <div class="guide">
      <h1 class="guide__title"><%= t("guide.title") %></h1>
      <p class="guide__intro"><%= t("guide.intro") %></p>

      <section class="section">
        <h2 class="guide__heading">Зачем этот проект</h2>
        <p class="guide__lead">Мы независисый проект и идея построить открытые карты профессий — путь от новичка до уверенного специалиста, собранный из первоисточников и практики. Мы <strong>библиотекари, а не лекторы</strong>: не пересказываем документы своими словами, а говорим точно, какие главы прочитать и что после этого сделать руками. Материалы бесплатны и открыты (CC BY-SA) — навсегда; имя автора остаётся в истории каждой принятой правки.</p>
        <p class="guide__lead">Улучшить статью может каждый: читатель — предложив правку прямо на странице урока, эксперт — проверяя правки и развивая карту своей профессии. Задача этой памятки — чтобы все статьи говорили одним голосом.</p>
      </section>

      <section class="section">
        <h2 class="guide__heading">Анатомия хорошего урока</h2>
        <ol class="guide-steps">
          <li><strong>ЗАЧЕМ.</strong> Первый абзац одним-двумя предложениями честно отвечает «зачем тратить на это время» — конкретно, без общих слов. Он же показывается в поиске, поэтому до 155 знаков.</li>
          <li><strong>Суть.</strong> Объяснение как мастер напарнику: числа, марки, главы нормативов («глава 1.7 ПУЭ», а не «нормативная документация»). Если для задачи есть стандартная программа или прибор — назовите его по имени и скажите, зачем он.</li>
          <li><strong>Ссылки.</strong> Курированные и ранжированные: обязательные и рекомендуемые — двумя группами. Где тема регулируется — первоисточник (Норматив); где нет — лучший качественный материал, честно помеченный. Типы разобраны ниже.</li>
          <li><strong>Закрытие по пользе.</strong> Теория заканчивается самопроверкой <code>[!ПРОВЕРЬ]</code> — вопросами, которые заставляют думать, а не вспоминать. Практический навык — заданием: цель, что понадобится, шаги, самопроверка по нормативу. Ничего «для галочки»: разделу нечего дать — его не должно быть.</li>
          <li><strong>Безопасность.</strong> Везде, где работа касается напряжения, давления, высоты или газа — блок <code>[!ОПАСНО]</code>. В рабочих профессиях плохой совет калечит; это главный критерий проверки любой правки.</li>
        </ol>
      </section>

      <section class="section">
        <h2 class="guide__heading">Три «нельзя»</h2>
        <ol class="guide-steps">
          <li><strong>Не выдумывать ссылки.</strong> Нет уверенного источника — оставьте пробел и напишите об этом в правке или автору. Одна фальшивая ссылка разрушает доверие ко всей странице.</li>
          <li><strong>Не пересказывать норматив вместо ссылки на него.</strong> Пересказ устаревает и врёт; наша ценность — привести человека к первоисточнику и показать, что именно там смотреть.</li>
          <li><strong>Не копировать чужие тексты.</strong> Всё здесь открыто под CC BY-SA — класть можно только то, что вправе распространяться свободно. Своими словами — можно и нужно.</li>
        </ol>
      </section>

      <% if @reference_lessons.any? %>
        <section class="section">
          <h2 class="guide__heading">Эталоны</h2>
          <p class="guide__lead">Быстрее любой памятки — посмотреть, как устроены образцовые уроки:</p>
          <ul class="guide-steps">
            <% @reference_lessons.each do |lesson| %>
              <li><%= link_to lesson.title, lesson_path(lesson) %></li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="section">
        <h2 class="guide__heading">Как живёт статья</h2>
        <p class="guide__lead">Любой зарегистрированный читатель может предложить правку прямо на странице урока. Правку проверяет эксперт профессии — практик с подтверждённым опытом; принятая правка становится вечной записью в открытой истории урока с именем автора: ничего не теряется и не переписывается задним числом. Ошибка — не страшно: откат — это просто новая запись в истории. Публикация новых профессий и курсов — за администратором.</p>
      </section>

      <section class="section">
        <h2 class="guide__heading">Вы — Эксперт: как это работает</h2>
        <p class="guide__lead">Эксперт — практик, которому открыто редактирование своих профессий (раздел Admin в меню). Пять вещей, которые стоит знать в первый день:</p>
        <ol class="guide-steps">
          <li><strong>Ваша зона — ваши профессии.</strong> Редактировать напрямую можно уроки профессий, к которым вам открыт доступ. В остальных вы предлагаете правки как читатель — тем же способом, с той же страницы урока.</li>
          <li><strong>Очередь правок.</strong> Бейдж «Правки» в админ-меню — предложения читателей к вашим профессиям. Смотрите сравнение «Рядом», принимайте то, что улучшает урок. Комментарий при отклонении увидит автор правки — пишите его человеку, а не «для протокола». Если очередь ждёт дольше двух дней, придёт одно письмо-напоминание.</li>
          <li><strong>Ваш труд защищён.</strong> Первая же ваша правка «замораживает» урок: никакой импорт или ИИ-черновик его не перезапишет. Каждое изменение — вечная запись в истории урока; откат — просто новая запись. Ошибок можно не бояться.</li>
          <li><strong>Новая профессия или курс.</strong> «Программа» — конструктор: добавляйте курсы и уроки, перетаскивайте, переименовывайте двойным кликом. «Импорт» — загрузите пак профессии (.zip) или вставьте YAML: сначала предпросмотр, без подтверждения ничего не записывается. Всё рождается черновиком — читатели его не видят.</li>
          <li><strong>Публикация.</strong> Когда материал готов, поставьте статус «На проверке» — опубликует администратор. Это последний рубеж качества, а не недоверие.</li>
        </ol>
      </section>

      <section class="section">
        <h2 class="guide__heading">Типы ссылок</h2>
        <p class="guide__lead">Тип отвечает на вопрос «что это». Один тип на ссылку. Принцип — тип по делу: где тема регулируется, ставим первоисточник (Норматив); где нет — лучший качественный источник, честно помеченный.</p>
        <dl class="guide-types">
          <% type_notes.each do |kind, note| %>
            <div class="guide-type">
              <dt><%= resource_kind_badge(Resource.new(kind: kind)) %></dt>
              <dd><%= note %></dd>
            </div>
          <% end %>
        </dl>
      </section>

      <section class="section">
        <h2 class="guide__heading">Заметка к ссылке</h2>
        <p class="guide__lead">Необязательная тихая строка под ссылкой — «что именно смотреть»: глава, разделы, минуты. Для документа на 400 страниц это разница между «прочитал нужное» и «закрыл вкладку». Пример: «только гл. 1.7, разделы 1.7.50–1.7.60»; для видео — «с 12-й минуты».</p>
      </section>

      <section class="section">
        <h2 class="guide__heading">Маркеры</h2>
        <p class="guide__lead">Маркер — вторая ось, поверх типа. У ссылки может быть ноль или несколько; маркер не меняет тип и не влияет на порядок.</p>
        <dl class="guide-types">
          <div class="guide-type">
            <dt><span class="badge badge--lang">EN</span></dt>
            <dd>Источник на английском, когда у материала нет качественного русского аналога. Английский — международный язык техники: так мы честно берём лучшую мировую практику (US/IEC/ASME, даташиты) и помечаем, что материал не на русском. По умолчанию язык русский — без бейджа.</dd>
          </div>
        </dl>
      </section>

      <section class="section">
        <h2 class="guide__heading">Текстовые блоки</h2>
        <p class="guide__lead">Цветные блоки помогают выделить смысл — опасность, важный факт, совет. Вставляются в три шага:</p>
        <ol class="guide-steps">
          <li>На новой строке нажмите кнопку <strong>цитаты</strong> (<code>&#10078;</code> на панели редактора) — или просто наберите <code>&gt; </code> в начале строки.</li>
          <li>Первым внутри цитаты впишите <strong>маркер</strong> — например <code>[!СОВЕТ]</code>. Заглавными, в квадратных скобках с восклицательным знаком.</li>
          <li>На той же строке, сразу после маркера, напишите текст блока.</li>
        </ol>
        <p class="guide__lead">Важно понимать: <strong>в самом редакторе это останется обычной цитатой</strong> с текстом «<code>[!СОВЕТ] …</code>». Цвет, иконка и подпись появятся уже на опубликованной странице урока. Маркеров ровно пять (ниже); ставьте по делу, не для украшения.</p>
        <% callout_notes.each do |key, info| %>
          <div class="guide-callout">
            <%= markdown("> [!#{key}] #{info[:sample]}") %>
            <p class="guide-callout__when"><strong>Когда:</strong> <%= info[:when] %></p>
            <pre class="guide-callout__syntax"><code>цитата → [!<%= key %>] текст блока…</code></pre>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</section>
