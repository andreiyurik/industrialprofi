<% meta_title(t("authors.title")) %>
<% meta_description(t("authors.meta_description")) %>
<% canonical_url("#{site_config.url}/authors") %>

<section class="section">
  <div class="container container--reading">
    <div class="authors">

      <header class="authors-hero">
        <p class="authors-hero__eyebrow"><%= t("authors.eyebrow") %></p>
        <h1 class="authors-hero__title"><%= t("authors.hero_title") %></h1>
        <p class="authors-hero__intro"><%= t("authors.hero_intro") %></p>
      </header>

      <div class="authors-frame">
        <p><%= t("authors.frame1") %></p>
        <p class="authors-frame__highlight"><%= t("authors.frame_highlight") %></p>
        <p><%= t("authors.frame2") %></p>
      </div>

      <%# The benefits — the page's core, from the master's point of view. %>
      <section class="authors-block">
        <h2 class="authors-block__title"><%= t("authors.benefits_title") %></h2>
        <p class="authors-block__lead"><%= t("authors.benefits_lead") %></p>

        <ol class="authors-benefits">
          <% t("authors.benefits").values.each_with_index do |benefit, i| %>
            <li class="authors-benefit">
              <span class="authors-benefit__index" aria-hidden="true"><%= format("%02d", i + 1) %></span>
              <h3 class="authors-benefit__title"><%= benefit[:title] %></h3>
              <p class="authors-benefit__text"><%= benefit[:text] %></p>
            </li>
          <% end %>
        </ol>
      </section>

      <%# Who it's for — the honest gate, kept short. %>
      <section class="authors-block">
        <h2 class="authors-block__title"><%= t("authors.who_title") %></h2>
        <p class="authors-block__lead"><%= t("authors.who_lead") %></p>
        <ul class="authors-who">
          <% t("authors.who").each do |item| %>
            <li class="authors-who__item"><%= item %></li>
          <% end %>
        </ul>
      </section>

      <%# How to start — brief; the full pipeline lives on /contribute. %>
      <section class="authors-block">
        <h2 class="authors-block__title"><%= t("authors.steps_title") %></h2>
        <p class="authors-block__lead"><%= t("authors.steps_lead") %></p>
        <ol class="authors-steps">
          <% t("authors.steps").each_with_index do |step, i| %>
            <li class="authors-steps__step">
              <span class="authors-steps__num" aria-hidden="true"><%= i + 1 %></span>
              <div class="authors-steps__body">
                <h3 class="authors-steps__title"><%= step[:title] %></h3>
                <p class="authors-steps__desc"><%= step[:desc] %></p>
              </div>
            </li>
          <% end %>
        </ol>
      </section>

      <div class="authors-cta panel">
        <h2 class="authors-cta__title"><%= t("authors.cta_title") %></h2>
        <p class="authors-cta__text"><%= t("authors.cta_text") %></p>
        <div class="authors-cta__links">
          <a href="<%= new_coauthor_application_path %>" class="btn btn--reversed"><%= t("authors.cta_apply") %></a>
          <a href="<%= contribute_path %>" class="btn"><%= t("authors.cta_contribute") %></a>
        </div>
      </div>

    </div>
  </div>
</section>
