<% meta_title(t("suggestions.page_title")) %>
<%# Asks the layout for the editor's stylesheets — readers don't get them. %>
<% content_for :rich_text_editor, true %>

<section class="admin-page">
  <div class="container container--reading">
    <%= render "shared/breadcrumbs", crumbs: [
      { title: @lesson.path.title, path: path_path(@lesson.path) },
      { title: @lesson.title, path: lesson_path(@lesson) },
      { title: t("suggestions.breadcrumb") }
    ] %>

    <header class="admin-header">
      <h1 class="admin-header__title"><%= t("suggestions.title") %></h1>
    </header>

    <p class="lesson-edit-prompt"><%= t("suggestions.subtitle", lesson: @lesson.title) %></p>
    <p class="lesson-edit-prompt"><%= t("suggestions.guide_hint_html", link: link_to("памятке автора", guide_path, target: "_blank")) %></p>

    <% if @suggestion.errors.any? %>
      <div class="admin-alert admin-alert--error">
        <% @suggestion.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with(model: @suggestion, url: lesson_suggestions_path(@lesson)) do |f| %>
      <%= f.hidden_field :section %>

      <%# No honeypot here on purpose: every author is signed in and rate-limited,
          and autofill tripping a hidden field silently destroyed real work.
          The guest business form keeps its own honeypot. %>

      <div class="admin-form__field">
        <label><%= t("suggestions.field_section") %></label>
        <p class="suggestion-section"><%= t("suggestions.section_#{@section}") %></p>
      </div>

      <div class="admin-form__field admin-form__field--lg">
        <label><%= t("suggestions.field_content") %></label>
        <p class="admin-form__hint"><%= t("suggestions.field_content_hint") %></p>
        <%# attachments: false fully disables uploads (toolbar + paste + drag-drop),
            not just the button — readers must never write files to the SQLite disk. %>
        <%= f.rich_text_area :rich_body, class: "lexxy-content", attachments: "false",
              placeholder: t("suggestions.placeholder") %>
      </div>

      <div class="admin-form__field admin-form__field--lg">
        <label><%= t("revisions.reason") %></label>
        <p class="admin-form__hint"><%= t("revisions.reason_hint") %></p>
        <%= f.text_field :edit_reason,
            placeholder: t("revisions.reason_placeholder"),
            class: "input" %>
      </div>

      <p class="admin-form__hint admin-form__field--lg"><%= t("suggestions.signed_as", name: Current.user.name) %></p>
      <p class="admin-form__hint admin-form__field--lg"><%= t("suggestions.review_note") %></p>

      <div class="admin-form__actions">
        <%= f.submit t("suggestions.submit"), class: "btn btn--reversed" %>
        <a href="<%= lesson_path(@lesson) %>" class="btn"><%= t("admin.cancel") %></a>
      </div>
    <% end %>
  </div>
</section>
