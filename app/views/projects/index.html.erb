<% meta_title(t("projects.title")) %>
<% meta_description(t("projects.subtitle")) %>
<% canonical_url(projects_url) %>

<% saved_param = @saved_only ? "1" : nil %>

<section class="section">
  <div class="container">
    <div class="txt-align-center">
      <h1 class="section-title"><%= t("projects.title") %></h1>
      <p class="section-subtitle"><%= t("projects.subtitle") %></p>
      <p class="projects__stats"><%= t("projects.tasks", count: @total_tasks) %> · <%= t("projects.paths_count", count: @paths.size) %></p>
    </div>

    <nav class="project-filters" aria-label="<%= t("projects.filters_label") %>">
      <div class="project-filters__group">
        <%= link_to t("projects.any_difficulty"), projects_path(saved: saved_param),
                    class: "filter-chip", "aria-current": @selected_difficulty.nil? || nil %>
        <% Lesson::DIFFICULTIES.each do |difficulty| %>
          <%# Icon-only chips (founder call, 2026-08-03): the wrench count IS
              the label — chili-pepper ordinality needs no caption. The word
              stays for screen readers; hover gets the word + the ladder
              definition via the chip's own native tooltip (the mark's is
              suppressed so it can't shadow this one). %>
          <%= link_to projects_path(difficulty: difficulty, saved: saved_param),
                      class: "filter-chip",
                      title: "#{t("lessons.difficulty.#{difficulty}")} — #{t("projects.difficulty_hints.#{difficulty}")}",
                      "aria-current": (@selected_difficulty == difficulty) || nil do %>
            <%= render "shared/difficulty_mark", difficulty: difficulty, tooltip: false %>
          <% end %>
        <% end %>
      </div>
      <% if signed_in? %>
        <div class="project-filters__group">
          <%= link_to projects_path(difficulty: @selected_difficulty, saved: @saved_only ? nil : "1"),
                      class: "filter-chip filter-chip--saved", "aria-current": @saved_only || nil do %>
            <%= icon_tag @saved_only ? "bookmark-simple-fill" : "bookmark-simple" %>
            <%= t("projects.saved_filter") %>
          <% end %>
        </div>
      <% end %>
      <%# With a level picked, the count line also DEFINES the level (the
          difficulty ladder from the authoring canon) — the meaning appears
          exactly when the reader reaches for it, zero standing noise. Only
          shown once a filter is active — with none, it would just repeat the
          header stat ("68 заданий" twice). %>
      <% if @selected_difficulty || @saved_only %>
        <p class="project-filters__count"><%= t("projects.found", count: @found_count) %><% if @selected_difficulty %> · <%= t("projects.difficulty_hints.#{@selected_difficulty}") %><% end %></p>
      <% end %>
    </nav>

    <% if @lessons_by_path.any? %>
      <div class="project-groups">
        <% @lessons_by_path.each do |path, lessons| %>
          <% done_count = signed_in? ? lessons.count { |l| @completed_ids.include?(l.id) } : 0 %>
          <section class="project-group">
            <h2 class="project-group__heading">
              <%# The profession's own emblem (same data as /paths and the course
                  hero), stripped to the regular weight — the -light glyphs are
                  sized for ≥32px emblem contexts, too thin at this heading size. %>
              <%= link_to path_practice_path(path), class: "project-group__link" do %>
                <%= icon_tag path.emblem.delete_suffix(Icon::EMBLEM_SUFFIX), class: "project-group__icon" %>
                <%= path.title %>
              <% end %>
              <%# The honest motivator (goal-gradient): a plain count of the
                  remaining set, ledger-style at the row's end. Green only at
                  the earned moment — the set is closed. Hidden at zero — a row
                  of "0 из N" everywhere motivates nothing, just noise. %>
              <% if done_count.positive? %>
                <span class="project-group__count<%= " project-group__count--complete" if done_count == lessons.size %>">
                  <%= t("projects.group_progress", done: done_count, total: lessons.size) %>
                </span>
              <% end %>
            </h2>
            <%# The same to-do rows as the profession's own «Практика» tab — a
                checkbox and a name, nothing else (the level is the chip filter
                above); two columns on wide screens so 70 tasks don't become one
                long sheet. %>
            <ul class="todo__items todo__items--columns" role="list">
              <% lessons.each do |lesson| %>
                <%= render "shared/todo_item", lesson: lesson, done: @completed_ids.include?(lesson.id),
                      bookmarked: @bookmarked_ids.include?(lesson.id), meta: nil %>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    <% elsif @saved_only && @selected_difficulty.nil? %>
      <p class="projects__empty">
        <%= t("projects.empty_saved") %>
        <%= link_to t("projects.reset_filters"), projects_path %>
      </p>
    <% elsif @selected_difficulty || @saved_only %>
      <p class="projects__empty">
        <%= t("projects.empty_filtered") %>
        <%= link_to t("projects.reset_filters"), projects_path %>
      </p>
    <% else %>
      <p class="projects__empty"><%= t("projects.empty") %></p>
    <% end %>
  </div>
</section>
