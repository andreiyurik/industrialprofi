<%# locals: (lesson:, done: false, bookmarked: false) -%>
<%# The row is one flex line; the bookmark button is its SIBLING (a button
    can't live inside a link) trailing it. %>
<li class="project-row-wrap">
  <%# Difficulty carries ONE signal now (the badge), not two — a colour ring
      around the whole row was redundant once the badge itself named + tinted
      the level. The numeral inside the badge pairs it with the filter chips
      above (I/II/III), which stay icon-only per the 2026-08-03 call. %>
  <a href="<%= lesson_path(lesson) %>"
     class="project-row<%= " project-row--done" if done %>">
    <%# Badge on its own line, not beside the title — inline, its width (I/II/III
        wear different widths) shifted where each title wrapped, so every row
        wrapped at a different column width. Stacked, the title always starts
        at the same edge with the same available width (founder call,
        2026-08-15). %>
    <span class="project-row__header">
      <span class="badge badge--<%= lesson.difficulty %>">
        <%= render "shared/difficulty_mark", difficulty: lesson.difficulty, sr_label: false, tooltip: false %>
        <%= t("lessons.difficulty.#{lesson.difficulty}") %>
      </span>
      <% if done %>
        <span class="project-row__check">
          <%= icon_tag "check-circle-fill" %>
          <span class="for-screen-reader"><%= t("projects.done") %></span>
        </span>
      <% end %>
    </span>
    <span class="project-row__title"><%= project_title(lesson) %></span>
  </a>
  <% if signed_in? %>
    <%= render "lessons/bookmark_button", lesson: lesson, bookmarked: bookmarked %>
  <% end %>
</li>
