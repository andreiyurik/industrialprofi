<%# locals: (lesson:, done: false, bookmarked: false) -%>
<%# The tile is one big <a>; the bookmark button is its SIBLING (a button can't
    live inside a link), absolutely positioned over the top-right corner. %>
<li class="project-tile-wrap">
  <a href="<%= lesson_path(lesson) %>" class="panel panel--hover project-tile">
    <span class="project-tile__top">
      <%= render "shared/difficulty_scale", difficulty: lesson.difficulty %>
      <% if done %>
        <span class="project-tile__done" title="<%= t("projects.done") %>">
          <%= heroicon "check-circle", variant: :solid %>
        </span>
      <% end %>
    </span>
    <span class="project-tile__title"><%= project_title(lesson) %></span>
  </a>
  <% if signed_in? %>
    <%= render "lessons/bookmark_button", lesson: lesson, bookmarked: bookmarked %>
  <% end %>
</li>
