<% content_for :mailer_footer do %>
  <p style="<%= mail_style(:muted) %>"><%= mail_link_to t("reminders_mailer.continue_learning.unsubscribe"), @unsubscribe_url %></p>
<% end %>

<h1 style="<%= mail_style(:title) %>"><%= t("reminders_mailer.continue_learning.greeting", name: @user.name) %></h1>

<p style="<%= mail_style(:subtitle) %>"><%= t("reminders_mailer.continue_learning.body", path: @path.title, lesson: @lesson.title) %></p>

<%= render "shared/mailer/button", text: t("reminders_mailer.continue_learning.cta"), url: lesson_url(@lesson) %>

<p style="<%= mail_style(:muted) %>"><%= t("reminders_mailer.continue_learning.once") %></p>

<p style="<%= mail_style(:muted) %>"><%= mail_link_to t("reminders_mailer.continue_learning.feedback"), new_feedback_url %></p>
