<%# locals: (caption: nil) -%>
<% scope = "diagrams.packet_route" %>
<% stories = {
  "neighbor" => { target: "scada", net: "192.168.1", host: ".20", path: "M82 125V232", mark: [ 126, 222 ], label: [ 148, 228, "start" ], ok: true },
  "mes" => { target: "mes", net: "192.168.2", host: ".10", path: "M82 125V170H275V232", mark: [ 236, 222 ], label: [ 214, 228, "end" ], ok: true },
  "nogw" => { target: "mes", net: "192.168.2", host: ".10", mark: [ 126, 124 ], label: [ 148, 129, "start" ] },
  "wrong" => { target: "scada", net: "192.168.0", host: ".20", path: "M82 125V170H176", mark: [ 273, 114 ], label: [ 273, 90, "middle" ] }
} %>
<% targets = { "scada" => [ 7, 250 ], "mes" => [ 200, 250 ] } %>
<%= render layout: "diagrams/figure", locals: { slug: "packet-route", caption: caption } do %>
  <div class="diagram__controls" role="radiogroup" aria-label="<%= t("choose", scope: scope) %>">
    <% stories.each_key do |story| %>
      <label class="diagram__option">
        <%= tag.input type: "radio", name: "packet-route-story", id: "packet-route-story-#{story}", checked: story == stories.keys.first %>
        <%= t("stories.#{story}", scope: scope) %>
      </label>
    <% end %>
  </div>
  <div class="diagram__stage">
    <svg class="diagram__art" viewBox="0 0 360 340" role="img" aria-label="<%= t("alt", scope: scope) %>">
      <path class="packet-route-zone" d="M2 2H174V126H358V214H174V338H2Z" />
      <rect class="packet-route-zone" x="192" y="228" width="166" height="110" />
      <text class="art-tag" x="12" y="21" text-anchor="start"><%= t("network", scope: scope) %> 192.168.1</text>
      <text class="art-tag" x="275" y="333" text-anchor="middle"><%= t("network", scope: scope) %> 192.168.2</text>

      <path class="art-wire" d="M82 110V250" />
      <g class="packet-route-dim-neighbor packet-route-dim-nogw">
        <path class="art-wire" d="M82 170H198" />
      </g>
      <g class="packet-route-dim-neighbor packet-route-dim-nogw">
        <path class="art-wire" d="M275 203V250" />
      </g>

      <rect class="art-ink art-body" x="7" y="32" width="150" height="78" rx="8" />
      <text class="packet-route-name" x="82" y="55"><%= t("plc", scope: scope) %></text>
      <text class="packet-route-ip" x="82" y="78">192.168.1.10</text>
      <text class="packet-route-note packet-route-except-nogw" x="82" y="99"><%= t("gw_set", scope: scope) %></text>
      <text class="packet-route-note packet-route-bad packet-route-on-nogw" x="82" y="99"><%= t("gw_unset", scope: scope) %></text>

      <g class="packet-route-dim-nogw">
        <rect class="art-ink art-body" x="55" y="155" width="54" height="30" rx="5" />
        <path class="art-quiet" d="M65 165H99L94 161M99 175H65L70 179" />
        <text class="art-tag" x="153" y="150"><%= t("switch", scope: scope) %></text>
      </g>

      <g class="packet-route-dim-neighbor packet-route-dim-nogw">
        <rect class="art-ink art-body" x="198" y="137" width="152" height="66" rx="8" />
        <text class="packet-route-name" x="274" y="164"><%= t("gateway", scope: scope) %></text>
        <text class="packet-route-ip" x="274" y="189">192.168.1.1</text>
      </g>

      <g class="packet-route-dim-mes packet-route-dim-nogw">
        <rect class="art-ink art-body" x="7" y="250" width="150" height="66" rx="8" />
        <text class="packet-route-name" x="82" y="278"><%= t("scada", scope: scope) %></text>
        <text class="packet-route-ip packet-route-except-wrong" x="82" y="302">192.168.1.20</text>
        <text class="packet-route-ip packet-route-bad packet-route-on-wrong" x="82" y="302">192.168.0.20</text>
      </g>

      <g class="packet-route-dim-neighbor packet-route-dim-wrong">
        <rect class="art-ink art-body" x="200" y="250" width="150" height="66" rx="8" />
        <text class="packet-route-name" x="275" y="278"><%= t("mes", scope: scope) %></text>
        <text class="packet-route-ip" x="275" y="302">192.168.2.10</text>
      </g>

      <% stories.each do |name, story| %>
        <% x, y = targets.fetch(story[:target]) %>
        <g class="packet-route-run packet-route-run--<%= name %> <%= "packet-route-run--ok" if story[:ok] %> packet-route-on-<%= name %>">
          <rect class="packet-route-target" x="<%= x %>" y="<%= y %>" width="150" height="66" rx="8" />
          <rect class="packet-route-pill" x="<%= x + 100 %>" y="<%= y - 11 %>" width="46" height="21" rx="10" />
          <text class="packet-route-goal" x="<%= x + 123 %>" y="<%= y + 4 %>"><%= t("goal", scope: scope) %></text>
          <% if story[:path] %>
            <path class="packet-route-trail" d="<%= story[:path] %>" pathLength="100" />
          <% end %>
          <g class="packet-route-packet">
            <rect x="-19" y="-13" width="38" height="26" rx="4" />
            <path d="M-17 -10 0 3 17 -10" />
          </g>
          <g class="packet-route-result">
            <g transform="translate(<%= story[:mark].join(" ") %>)">
              <circle r="15" />
              <path d="<%= story[:ok] ? "M-8 0 -2 6 8 -6" : "M-6 -6 6 6M6 -6 -6 6" %>" />
            </g>
            <text x="<%= story[:label][0] %>" y="<%= story[:label][1] %>" text-anchor="<%= story[:label][2] %>"><%= t("mark.#{name}", scope: scope) %></text>
          </g>
        </g>
      <% end %>
    </svg>
  </div>
  <% stories.each do |name, story| %>
    <% own = story[:net] == "192.168.1" %>
    <ol class="packet-route-steps packet-route-on-<%= name %> <%= "packet-route-steps--ok" if story[:ok] %>">
      <li class="packet-route-step packet-route-step--compare">
        <strong><%= t("steps.compare", scope: scope) %></strong>
        <div class="packet-route-answer">
          <% [ [ "plc", "192.168.1", ".10" ], [ story[:target], story[:net], story[:host] ] ].each do |device, net, host| %>
            <span class="packet-route-address">
              <span><%= t("short.#{device}", scope: scope) %></span>
              <span class="packet-route-net <%= "packet-route-net--differs" if net != "192.168.1" %>"><%= net %></span>
              <span><%= host %></span>
            </span>
          <% end %>
          <b class="packet-route-match"><%= t(own ? "same" : "differs", scope: scope) %></b>
          <small><%= t("mask", scope: scope) %></small>
        </div>
      </li>
      <li class="packet-route-step packet-route-step--send">
        <strong><%= t("steps.send", scope: scope) %></strong>
        <div class="packet-route-answer"><%= t("send.#{name}", scope: scope) %></div>
      </li>
      <li class="packet-route-step packet-route-step--result">
        <strong><%= t("steps.result", scope: scope) %></strong>
        <div class="packet-route-answer"><%= t("result.#{name}", scope: scope) %></div>
      </li>
    </ol>
  <% end %>
<% end %>
