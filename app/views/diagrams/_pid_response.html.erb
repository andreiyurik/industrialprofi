        <text x="191" y="289">50</text>
        <text x="316" y="289">100</text>
        <text x="441" y="289">150</text>
      </g>
      <text class="art-tag" x="10" y="19"><%= t("#{k}.y_axis") %></text>
      <text class="art-tag" x="253" y="307" text-anchor="middle"><%= t("#{k}.x_axis") %></text>

      <path class="pid-area" clip-path="url(#pid-response-clip-pi-<%= uid %>)" d="<%= curves["pi"] %> L441 72 L66 72Z" />

      <path class="pid-setpoint" d="M46 252H66V72H448" />
      <text class="pid-setpoint-name" x="448" y="23" text-anchor="end"><%= t("#{k}.setpoint") %></text>
      <path class="pid-setpoint-lead" d="M440 29V66" />
      <path class="pid-setpoint-tip" d="M436 62l4 7 4-7z" />

      <% curves.each do |name, d| %>
        <g class="pid-curve pid-curve--<%= name %>">
          <path class="pid-line" clip-path="url(#pid-response-clip-<%= name %>-<%= uid %>)" d="<%= d %>" />
        </g>
      <% end %>

      <g class="pid-note pid-note--p">
        <path class="pid-bracket" d="M404 73V98 M399 73h10 M399 98h10" />
        <text x="396" y="121" text-anchor="middle"><%= t("#{k}.offset") %></text>
      </g>
      <g class="pid-note pid-note--pi">
        <circle cx="145.7" cy="51.5" r="3.5" />
        <text x="145.7" y="41.5" text-anchor="middle"><%= t("#{k}.peak_pi") %></text>
      </g>
      <g class="pid-note pid-note--pid">
        <circle cx="185.9" cy="66.7" r="3.5" />
        <path class="pid-leader" d="M185.9 61.7 V48" />
        <text x="185.9" y="42" text-anchor="middle"><%= t("#{k}.peak_pid") %></text>
      </g>

      <% curves.each_key.with_index do |name, index| %>
        <g class="pid-key pid-key--<%= name %>" transform="translate(150 <%= 172 + index * 30 %>)">
          <path class="pid-line" d="M0 0H44" />
          <text class="pid-key__name" x="54" y="5"><%= t("#{k}.names.#{name}") %></text>
          <text x="106" y="5"><%= t("#{k}.keys.#{name}") %></text>
        </g>
      <% end %>

      <% curves.each_key do |name| %>
        <circle class="pid-head pid-head--<%= name %>" r="5" />
      <% end %>
    </svg>
  </div>
  <p class="diagram__phases">
    <% %w[rise offset integral derivative summary only_p only_pi only_pid].each do |phase| %>
      <span class="pid-phase pid-phase--<%= phase.dasherize %>"><%= t("#{k}.phases.#{phase}") %></span>
    <% end %>
  </p>
  <div class="diagram__controls" role="radiogroup" aria-label="<%= t("#{k}.choose") %>">
    <% %w[all p pi pid].each do |name| %>
      <label class="diagram__option">
        <input type="radio" id="pid-response-<%= name %>" name="pid-response-curve-<%= uid %>" <% if name == "all" %>checked<% end %>>
        <%= t("#{k}.names.#{name}") %>
      </label>
    <% end %>
  </div>
  <p class="pid-model"><%= t("#{k}.model") %></p>
<% end %>
