<%= render layout: "diagrams/figure", locals: { slug: "pid-response", caption: caption } do %>
  <div class="diagram__stage">
    <svg class="diagram__art" viewBox="0 0 480 316" role="img" aria-label="<%= t("#{k}.aria") %>">
      <defs>
        <% curves.each_key do |name| %>
          <clipPath id="pid-response-clip-<%= name %>-<%= uid %>">
            <rect class="pid-wipe pid-wipe--<%= name %>" x="62" y="0" width="386" height="290" />
          </clipPath>
        <% end %>
      </defs>

      <path class="art-far" d="M46 162H448 M46 99H448" />
      <path class="art-quiet" d="M46 30V270H448" />
      <path class="art-quiet" d="M42 252h4 M42 162h4 M42 99h4 M42 72h4 M66 270v4 M191 270v4 M316 270v4 M441 270v4" />
