<h1 style="<%= mail_style(:title) %>"><%= t("editorships_mailer.granted.greeting", name: @user.name) %></h1>

<p style="<%= mail_style(:subtitle) %>"><%= t("editorships_mailer.granted.body") %></p>

<ul style="<%= mail_style(:list) %>">
  <% @paths.each do |path| %>
    <li style="<%= mail_style(:list_item) %>">«<%= path.title %>»</li>
  <% end %>
</ul>

<p style="<%= mail_style(:paragraph) %>"><%= t("editorships_mailer.granted.now_you_can") %></p>

<%= render "shared/mailer/button", text: t("editorships_mailer.granted.cta"), url: admin_lesson_suggestions_url %>

<p style="<%= mail_style(:muted) %>"><%= t("editorships_mailer.granted.guide_html", link: mail_link_to(t("editorships_mailer.granted.guide_link"), guide_url)) %></p>

<p style="<%= mail_style(:muted) %>"><%= t("editorships_mailer.granted.curator_hint") %> <%= mail_link_to(t("account.title"), account_url) %></p>

<p style="<%= mail_style(:muted) %>"><%= t("editorships_mailer.granted.thanks") %></p>
