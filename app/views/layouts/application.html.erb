<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? content_for(:title) : "#{t('site.name')} — #{t('site.tagline')}" %></title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#000000">
    <meta name="description" content="<%= content_for?(:description) ? content_for(:description) : t('site.description') %>">
    <meta name="application-name" content="<%= t('site.name') %>">
    <meta name="robots" content="index, follow">

    <%# Native-app feel, no JS: Turbo animates page changes via the View
        Transitions API and morphs same-page refreshes while keeping scroll. %>
    <meta name="view-transition" content="same-origin">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">

    <%# Installable PWA (home-screen icon, standalone window). %>
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="apple-mobile-web-app-title" content="IndustrialProfi">
    <% if site_config.google_site_verification.present? %>
      <meta name="google-site-verification" content="<%= site_config.google_site_verification %>">
    <% end %>
    <% if site_config.yandex_verification.present? %>
      <meta name="yandex-verification" content="<%= site_config.yandex_verification %>">
    <% end %>
    <% if content_for?(:canonical) %>
      <link rel="canonical" href="<%= content_for(:canonical) %>">
    <% end %>

    <%# Open Graph %>
    <meta property="og:site_name" content="<%= t('site.name') %>">
    <meta property="og:locale" content="<%= og_locale %>">
    <meta property="og:type" content="<%= content_for(:og_type) || "website" %>">
    <meta property="og:title" content="<%= content_for?(:og_title) ? content_for(:og_title) : "#{t('site.name')} — #{t('site.tagline')}" %>">
    <meta property="og:description" content="<%= content_for?(:og_description) ? content_for(:og_description) : t('site.description') %>">
    <meta property="og:url" content="<%= og_url %>">
    <% if site_config.og_image.present? %>
      <meta property="og:image" content="<%= site_config.og_image %>">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
    <% end %>

    <%# Twitter Card — a large image when we have one, otherwise the compact card. %>
    <meta name="twitter:card" content="<%= site_config.og_image.present? ? "summary_large_image" : "summary" %>">
    <% if site_config.og_image.present? %>
      <meta name="twitter:image" content="<%= site_config.og_image %>">
    <% end %>
    <meta name="twitter:title" content="<%= content_for?(:og_title) ? content_for(:og_title) : "#{t('site.name')} — #{t('site.tagline')}" %>">
    <meta name="twitter:description" content="<%= content_for?(:og_description) ? content_for(:og_description) : t('site.description') %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# One built file instead of 64 links: every <link> blocks the first paint.
        Built by dartsass at assets:precompile — see application.scss. %>
    <%= stylesheet_link_tag "application", *vendor_stylesheets, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%# The controllers load on demand (importmap.rb), but the two files that
        boot Stimulus are wanted on every page — name them here, or they hang
        off application.js as two extra round trips before anything can react. %>
    <%= javascript_module_preload_tag asset_path("controllers/index.js"), asset_path("controllers/application.js") %>
    <%= render "shared/metrika" if site_config.metrika_id.present? %>
  </head>

  <body>
    <%# Absolute, so it stays out of body's 3-row grid until focus reveals it. %>
    <a href="#main-content" class="skip-nav"><%= t("nav.skip_to_content") %></a>

    <%# Hand-drawn line reused by every nav word's hover underline (via <use>).
        One rough double-stroke path; CodeMyUI "hand-drawn underline" technique. %>
    <svg width="0" height="0" aria-hidden="true" class="svg-defs">
      <defs>
        <path id="hand-line" fill="none" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"
              d="M2 2c49.7 2.6 100 3.1 150 1.7-46.5 2-93 4.4-139.2 7.3 45.2-1.5 90.6-1.8 135.8-.6"></path>
      </defs>
    </svg>

    <header class="header"
            data-controller="header-reveal"
            data-header-reveal-hidden-class="header--hidden">
      <nav class="container header__nav">
        <%= link_to root_path, class: "brand header__brand" do %>
          <%= image_tag "logo-ethernet.png", alt: "", class: "brand__mark", aria: { hidden: "true" } %>
          <span class="brand__text"><%= t("site.name") %></span>
        <% end %>
        <div class="header__right">
          <%# A quiet dot = a decision on one of your suggested edits you
              haven't seen yet; it leads to the dashboard, which clears it. %>
          <% unseen_outcomes = signed_in? && Current.user.unseen_suggestion_outcomes? %>
          <%# Compact (≤1023px): a <details> disclosure collapses the nav behind
              a hamburger; the details controller adds menu-style light dismiss
              (click outside / Esc). Wide (≥1024px): the toggle is hidden and
              the panel flows inline as the nav row — single source of links. %>
          <details class="header__menu" data-controller="details" data-details-target="details"
                   data-action="click@document->details#closeOnClickOutside keydown.esc@window->details#close">
            <summary class="header__menu-toggle" aria-label="<%= t("nav.menu") %>">
              <%= icon_tag "list" %>
              <% if unseen_outcomes %><span class="notify-dot notify-dot--corner"></span><% end %>
            </summary>
            <%# The ✕ floats in the strip right of the drawer (TOP's DrawerComponent:
                `absolute left-full w-16 pt-5`) — outside the scrolling panel, or its
                overflow would clip it. A closed <details> hides it natively. %>
            <button type="button" class="header__menu-close" data-action="details#close"
                    aria-label="<%= t("common.close") %>">
              <%= icon_tag "x" %>
            </button>
            <div class="header__menu-panel">
              <%# Guest drawer opens on the full brand (mark + wordmark), like
                  TOP's logo slot — on phones the header shows only the mark, so
                  this is the one nav surface carrying the project's name. A
                  signed-in reader gets the identity row in this slot instead. %>
              <% unless signed_in? %>
                <%= link_to root_path, class: "brand header__menu-brand" do %>
                  <%= image_tag "logo-ethernet.png", alt: "", class: "brand__mark", aria: { hidden: "true" } %>
                  <span class="brand__text"><%= t("site.name") %></span>
                <% end %>
              <% end %>

              <%# Mobile-only identity header — the SAME partial the desktop popover
                  renders, so the two menus read as one. %>
              <% if signed_in? %>
                <%= render "shared/account_identity", extra_class: "header__menu-identity" %>
              <% end %>

              <%# Icons render only in the mobile dropdown (hidden inline on
                  desktop) and match the palette tiles — one visual language. %>
              <%= link_to paths_path, class: "nav__link link-quiet",
                    aria: { current: ("page" if controller_name.in?(%w[paths lessons])) } do %>
                <%= icon_tag "map-trifold" %><%= t("nav.professions") %><%= render "shared/nav_underline" %>
              <% end %>
              <%= link_to projects_path, class: "nav__link link-quiet",
                    aria: { current: ("page" if current_page?(projects_path)) } do %>
                <%= icon_tag "wrench" %><%= t("nav.projects") %><%= render "shared/nav_underline" %>
              <% end %>
              <%# Ordered as the footer's "Обучение" column, which this mirrors. %>
              <%= link_to resources_path, class: "nav__link link-quiet",
                    aria: { current: ("page" if controller_name == "resources") } do %>
                <%= icon_tag "book-open" %><%= t("nav.library") %><%= render "shared/nav_underline" %>
              <% end %>
              <%= link_to calculators_path, class: "nav__link link-quiet",
                    aria: { current: ("page" if controller_name == "calculators") } do %>
                <%= icon_tag "calculator" %><%= t("nav.calculators") %><%= render "shared/nav_underline" %>
              <% end %>
              <% if controller.class.module_parent_name == "Admin" %>
                <span class="badge badge--marker header__context-badge">Admin</span>
              <% end %>
              <% unless signed_in? %>
                <%# Orientation for guests — mobile only. On desktop the top bar
                    stays product-only and these live in the footer, but there
                    the footer is a scroll away and this sheet is the only nav,
                    while "what is this site?" is a guest's first question. %>
                <div class="header__menu-guest">
                  <%= link_to about_path, class: "account-menu__link",
                        aria: { current: ("page" if current_page?(about_path)) } do %>
                    <%= icon_tag "info" %>
                    <%= t("nav.about") %>
                  <% end %>
                  <%# The recruit-an-expert door. Cheap to place, existential to
                      miss — a master who never finds it never authors a path. %>
                  <%= link_to authors_path, class: "account-menu__link",
                        aria: { current: ("page" if current_page?(authors_path)) } do %>
                    <%= icon_tag "users" %>
                    <%= t("nav.authors") %>
                  <% end %>
                  <%= link_to faq_path, class: "account-menu__link",
                        aria: { current: ("page" if current_page?(faq_path)) } do %>
                    <%= icon_tag "question" %>
                    <%= t("nav.faq") %>
                  <% end %>
                  <%# Support used to sit here too; it now lives in the top bar
                      itself, visible on every screen and to members as well. %>
                </div>
                <%# TOP's guest pair: Get started + Sign in. The signup row is
                    drawer-only (the desktop header has the CTA pill). %>
                <%= link_to new_signup_path, class: "nav__link link-quiet header__menu-signup",
                      aria: { current: ("page" if current_page?(new_signup_path)) } do %>
                  <%= icon_tag "user-plus" %><%= t("auth.sign_up") %>
                <% end %>
                <%= link_to new_session_path, class: "nav__link link-quiet header__menu-signin",
                      aria: { current: ("page" if current_page?(new_session_path)) } do %>
                  <%= icon_tag "sign-in" %><%= t("auth.sign_in") %>
                <% end %>
              <% end %>

              <%# The personal menu, reachable from the hamburger on a phone. Same
                  partial as the desktop popover — one list, two containers. %>
              <% if signed_in? %>
                <div class="header__menu-account">
                  <%= render "shared/account_links", unseen_outcomes: unseen_outcomes %>
                </div>
              <% end %>
            </div>
          </details>

          <%# The project runs on donations, so the door to /support_us is the one
              non-product link allowed in the top bar (see header.css). Worded on
              desktop — a hand-with-heart alone reads as "favourites" — and icon
              only where the row has no room. Same for guests and members: it
              used to be guest-and-mobile-only, so a signed-in reader had it
              nowhere but the footer. %>
          <%= link_to support_us_path, class: "header__support link-quiet",
                title: t("nav.support"),
                aria: { current: ("page" if current_page?(support_us_path)) } do %>
            <%= icon_tag "hand-heart-light" %>
            <%# One label, two states: read aloud always, shown only where the
                row has room (see header.css) — never a duplicated SR-only copy. %>
            <span class="header__support-label"><%= t("nav.support") %></span>
          <% end %>

          <%# Search is a quiet icon in the utility cluster (search + account)
              at the corner, after the nav words. Always visible, even on
              mobile. With JS it opens the command palette instead of the page;
              the hotkey is advertised by the tooltip and inside the palette. %>
          <div class="header__palette" data-controller="palette"
               data-action="keydown@document->palette#hotkey">
            <%= link_to search_path, class: "header__search link-quiet",
                  title: "#{t("nav.search")} (Ctrl+K)",
                  data: { action: "palette#open:prevent" },
                  aria: { current: ("page" if controller_name == "searches") } do %>
              <%= icon_tag "magnifying-glass" %>
              <span class="for-screen-reader"><%= t("nav.search") %></span>
            <% end %>
            <%= render "shared/palette" %>
          </div>

          <% if signed_in? %>
            <%# Fizzy-style account hub: everything personal lives behind one
                name button. Native popover — light-dismiss, zero JS. %>
            <button type="button" class="account-menu-button" popovertarget="account-menu">
              <%= avatar_tag(Current.user.name) %>
              <span class="account-menu-button__name"><%= Current.user.name %></span>
              <%= icon_tag "caret-down" %>
              <% if unseen_outcomes %><span class="notify-dot notify-dot--corner"></span><% end %>
            </button>

            <div id="account-menu" class="account-menu" popover>
              <%= render "shared/account_identity" %>
              <%= render "shared/account_links", unseen_outcomes: unseen_outcomes %>
            </div>
          <% else %>
            <%# The primary CTA stays visible on mobile (not buried in the menu). %>
            <%= link_to t("auth.sign_up"), new_signup_path, class: "btn btn--small btn--reversed header__cta" %>
          <% end %>
        </div>
      </nav>
    </header>

    <%= render "shared/flash" %>
    <%= render "shared/welcome_letter" if flash[:welcome_letter] %>
    <%= render "shared/editor_welcome_letter" if signed_in? && Current.user.needs_editor_welcome? %>

    <main id="main-content" class="<%= @layout_class %>">
      <%= yield %>
    </main>

    <% unless in_admin? %>
    <footer class="footer">
      <div class="container footer__inner">
        <div class="footer__brand-block">
          <a href="<%= root_path %>" class="brand">
            <%= image_tag "logo-ethernet.png", alt: "", class: "brand__mark", aria: { hidden: "true" } %>
            <span class="brand__text"><%= t("site.name") %></span>
          </a>
          <p class="footer__tagline"><%= t("site.tagline") %></p>
          <div class="footer__socials">
            <a href="<%= site_config.telegram_url %>" class="footer__social-link link-quiet" target="_blank" rel="noopener" aria-label="Telegram">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            </a>
            <a href="<%= site_config.github_url %>" class="footer__social-link link-quiet" target="_blank" rel="noopener" aria-label="GitHub">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
            <a href="<%= site_config.boosty_url %>" class="footer__social-link link-quiet" target="_blank" rel="noopener" aria-label="Boosty">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M2.661 14.337 6.801 0h6.362L11.88 4.444l-.038.077-3.378 11.733h3.15c-1.321 3.289-2.35 5.867-3.086 7.733-5.816-.063-7.442-4.228-6.02-9.155M8.554 24l7.67-11.035h-3.25l2.83-7.073c4.852.508 7.137 4.33 5.791 8.952C20.16 19.81 14.344 24 8.68 24h-.127z"/></svg>
            </a>
          </div>
        </div>

        <div class="footer__col">
          <p class="footer__heading"><%= t("footer.col_learning") %></p>
          <a href="<%= paths_path %>" class="footer__link link-quiet"><%= t("nav.professions") %></a>
          <a href="<%= projects_path %>" class="footer__link link-quiet"><%= t("nav.projects") %></a>
          <a href="<%= resources_path %>" class="footer__link link-quiet"><%= t("nav.library") %></a>
          <a href="<%= calculators_path %>" class="footer__link link-quiet"><%= t("nav.calculators") %></a>
          <a href="<%= glossary_path %>" class="footer__link link-quiet"><%= t("nav.glossary") %></a>
        </div>

        <div class="footer__col">
          <p class="footer__heading"><%= t("footer.col_project") %></p>
          <a href="<%= about_path %>" class="footer__link link-quiet"><%= t("nav.about") %></a>
          <a href="<%= faq_path %>" class="footer__link link-quiet"><%= t("nav.faq") %></a>
          <a href="<%= roadmap_path %>" class="footer__link link-quiet"><%= t("nav.roadmap") %></a>
          <a href="<%= business_path %>" class="footer__link link-quiet"><%= t("nav.business") %></a>
          <a href="<%= posts_path %>" class="footer__link link-quiet"><%= t("nav.news") %></a>
        </div>

        <div class="footer__col">
          <p class="footer__heading"><%= t("footer.col_support") %></p>
          <a href="<%= contribute_path %>" class="footer__link link-quiet"><%= t("nav.contribute") %></a>
          <a href="<%= authors_path %>" class="footer__link link-quiet"><%= t("nav.authors") %></a>
          <a href="<%= support_us_path %>" class="footer__link link-quiet"><%= t("nav.support") %></a>
          <a href="<%= partners_path %>" class="footer__link link-quiet"><%= t("nav.partners") %></a>
          <%# Signed-in readers write to the founder right on the site; guests go to Telegram. %>
          <% if signed_in? %>
            <a href="<%= new_feedback_path %>" class="footer__link link-quiet"><%= t("footer.feedback") %></a>
          <% else %>
            <a href="<%= site_config.telegram_url %>" class="footer__link link-quiet" target="_blank" rel="noopener"><%= t("footer.feedback") %></a>
          <% end %>
        </div>
      </div>

      <div class="container footer__bottom">
        <div class="footer__legal">
          <p class="footer__copy">
            <%= t("footer.copyright_html", year: Date.current.year, author_url: site_config.author_url) %>
          </p>
          <%# Honest, verifiable trust signal: the repo is public (AGPL) and the
              content is CC BY-SA — links go to the code and the license itself. %>
          <p class="footer__license">
            <%= t("footer.license_html", repo_url: site_config.github_url) %>
          </p>
        </div>
        <div class="footer__colophon">
          <a href="<%= privacy_path %>" class="footer__link link-quiet"><%= t("nav.privacy") %></a>
          <p class="footer__made-with">
            <%= t("footer.made_with_html", heart: icon_tag("heart-fill", class: "footer__heart")) %>
          </p>
        </div>
      </div>
    </footer>
    <% end %>
  </body>
</html>
