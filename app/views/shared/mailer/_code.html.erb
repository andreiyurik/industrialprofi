<%# The one-time code, sized to be read off a phone at a glance. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 0 auto 28px;">
  <tr>
    <td bgcolor="<%= MailerHelper::SURFACE %>" align="center" style="background-color: <%= MailerHelper::SURFACE %>; border: 1px solid <%= MailerHelper::HAIRLINE %>; border-radius: 12px; padding: 20px 26px 20px 32px; font-family: <%= MailerHelper::MONO_STACK %>; font-size: 32px; font-weight: 700; letter-spacing: 0.24em; line-height: 1.2; color: <%= MailerHelper::INK %>;"><%= code %></td>
  </tr>
</table>
