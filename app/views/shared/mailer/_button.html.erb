<%# The app's .btn--reversed (filled ink, black label) as a table — the only
    button construction Outlook's Word engine renders reliably, and align= is
    the only centring it honours. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 0 auto 28px;">
  <tr>
    <td bgcolor="<%= MailerHelper::INK %>" align="center" style="background-color: <%= MailerHelper::INK %>; border-radius: 8px;">
      <a href="<%= url %>" style="display: inline-block; padding: 13px 28px; font-family: <%= MailerHelper::FONT_STACK %>; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; color: <%= MailerHelper::BACKGROUND %>; text-decoration: none;"><%= text %></a>
    </td>
  </tr>
</table>
