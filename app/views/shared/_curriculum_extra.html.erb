<%# locals: (extra:) -%>
<%# Off-site links here carry no link equity and are marked as user content for crawlers. %>
<div class="curriculum__extra">
  <% if extra.note.present? %>
    <p class="curriculum__extra-note"><%= extra.note %></p>
  <% end %>
  <% extra.links.each do |link| %>
    <a href="<%= link.url %>" class="curriculum__extra-link" target="_blank" rel="nofollow ugc noopener">
      <%= icon_tag "arrow-up-right" %>
      <span><%= link.title %></span>
      <% if link.host %><span class="curriculum__extra-host"><%= link.host %></span><% end %>
    </a>
    <% if link.note.present? %><p class="curriculum__extra-note"><%= link.note %></p><% end %>
  <% end %>
</div>
