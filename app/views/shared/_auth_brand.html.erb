<%# Brand mark above the form — the hard-hat profi alone (no wordmark), sized up
    as a seal/icon. Links home; the alt carries the name for screen readers. %>
<%= link_to root_path, class: "auth__brand" do %>
  <%= image_tag "logo-mark.svg", alt: t("site.name"), class: "auth__brand-mark", width: 486, height: 707 %>
<% end %>
