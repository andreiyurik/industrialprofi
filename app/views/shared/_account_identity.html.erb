<%# locals: (extra_class: nil) -%>
<%# Rendered by both the drawer and the popover so they can't drift apart; `extra_class` is the drawer's show/hide hook. %>
<p class="account-menu__header <%= extra_class %>">
  <%= avatar_tag(Current.user) %>
  <span class="account-menu__identity">
    <span class="account-menu__name">
      <%= Current.user.name %>
      <% unless Current.user.member? %>
        <span class="badge badge--marker account-menu__role"><%= t("admin.roles.#{Current.user.role}") %></span>
      <% end %>
    </span>
    <span class="account-menu__email"><%= Current.user.email_address %></span>
  </span>
</p>
