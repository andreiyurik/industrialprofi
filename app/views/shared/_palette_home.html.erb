<nav class="palette__quick">
  <% if signed_in? %>
    <%= link_to dashboard_path, class: "palette__tile" do %>
      <%= icon_tag "house" %>
      <span><%= t("nav.dashboard") %></span>
    <% end %>
    <%= link_to paths_path, class: "palette__tile" do %>
      <%= icon_tag "map-trifold" %>
      <span><%= t("nav.professions") %></span>
    <% end %>
    <%= link_to journal_entries_path, class: "palette__tile" do %>
      <%= icon_tag "pencil-simple" %>
      <span><%= t("nav.journal") %></span>
    <% end %>
  <% else %>
    <%= link_to paths_path, class: "palette__tile" do %>
      <%= icon_tag "map-trifold" %>
      <span><%= t("nav.professions") %></span>
    <% end %>
    <%= link_to projects_path, class: "palette__tile" do %>
      <%= icon_tag "wrench" %>
      <span><%= t("nav.projects") %></span>
    <% end %>
    <%= link_to calculators_path, class: "palette__tile" do %>
      <%= icon_tag "calculator" %>
      <span><%= t("nav.calculators") %></span>
    <% end %>
  <% end %>
</nav>
<p class="palette__hint"><%= t("palette.hint") %></p>
